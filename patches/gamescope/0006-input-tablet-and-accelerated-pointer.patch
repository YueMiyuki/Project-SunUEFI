+struct wlserver_tablet {
+	struct wlr_tablet *wlr;
+	struct wlr_tablet_v2_tablet *v2;
+	struct wl_listener axis, proximity, tip, button, destroy;
+};
+
+struct wlserver_tablet_tool {
+	struct wlr_tablet_tool *wlr;
+	struct wlr_tablet_v2_tablet_tool *v2;
+	struct wl_listener destroy;
+	bool pointer_down = false;
+	bool pointer_right = false;
+	bool pointer_middle = false;
+};
+
+static void wlserver_tablet_release_pointer(wlserver_tablet_tool *tool, uint32_t time)
+{
+	if (tool->pointer_down) wlserver_mousebutton(BTN_LEFT, false, time);
+	if (tool->pointer_right) wlserver_mousebutton(BTN_RIGHT, false, time);
+	if (tool->pointer_middle) wlserver_mousebutton(BTN_MIDDLE, false, time);
+	tool->pointer_down = tool->pointer_right = tool->pointer_middle = false;
+}
+
+static void wlserver_handle_tablet_tool_destroy(struct wl_listener *listener, void *data)
+{
+	wlserver_tablet_tool *tool = wl_container_of(listener, tool, destroy);
+	wlserver_tablet_release_pointer(tool, 0);
+	tool->wlr->data = nullptr;
+	wl_list_remove(&tool->destroy.link);
+	delete tool;
+}
+
+static wlserver_tablet_tool *wlserver_get_tablet_tool(struct wlr_tablet_tool *wlr)
+{
+	if (wlr->data)
+		return static_cast<wlserver_tablet_tool *>(wlr->data);
+	auto *tool = new wlserver_tablet_tool{};
+	tool->wlr = wlr;
+	tool->v2 = wlr_tablet_tool_create(s_TabletManager, wlserver.wlr.seat, wlr);
+	if (!tool->v2) {
+		delete tool;
+		return nullptr;
+	}
+	tool->destroy.notify = wlserver_handle_tablet_tool_destroy;
+	wl_signal_add(&wlr->events.destroy, &tool->destroy);
+	wlr->data = tool;
+	return tool;
+}
+
+static bool wlserver_tablet_focus(wlserver_tablet *tablet, wlserver_tablet_tool *tool)
+{
+	auto *surface = wlserver.mouse_focus_surface;
+	if (surface && wlr_surface_accepts_tablet_v2(surface, tablet->v2)) {
+		wlserver_tablet_release_pointer(tool, 0);
+		wlr_tablet_v2_tablet_tool_notify_proximity_in(tool->v2, tablet->v2, surface);
+		return true;
+	}
+	wlr_tablet_v2_tablet_tool_notify_proximity_out(tool->v2);
+	return false;
+}
+
+static void wlserver_handle_tablet_axis(struct wl_listener *listener, void *data)
+{
+	wlserver_tablet *tablet = wl_container_of(listener, tablet, axis);
+	auto *event = static_cast<struct wlr_tablet_tool_axis_event *>(data);
+	auto *tool = wlserver_get_tablet_tool(event->tool);
+	if (!tool) return;
+	auto [x, y] = wlserver_absolute_coords(event->x, event->y);
+	if (wlserver_tablet_focus(tablet, tool)) {
+		if (event->updated_axes & (WLR_TABLET_TOOL_AXIS_X | WLR_TABLET_TOOL_AXIS_Y))
+			wlr_tablet_v2_tablet_tool_notify_motion(tool->v2, x, y);
+		if (event->updated_axes & WLR_TABLET_TOOL_AXIS_PRESSURE)
+			wlr_tablet_v2_tablet_tool_notify_pressure(tool->v2, event->pressure);
+		if (event->updated_axes & WLR_TABLET_TOOL_AXIS_DISTANCE)
+			wlr_tablet_v2_tablet_tool_notify_distance(tool->v2, event->distance);
+		if (event->updated_axes & (WLR_TABLET_TOOL_AXIS_TILT_X | WLR_TABLET_TOOL_AXIS_TILT_Y))
+			wlr_tablet_v2_tablet_tool_notify_tilt(tool->v2, event->tilt_x, event->tilt_y);
+		if (event->updated_axes & WLR_TABLET_TOOL_AXIS_ROTATION)
+			wlr_tablet_v2_tablet_tool_notify_rotation(tool->v2, event->rotation);
+		if (event->updated_axes & WLR_TABLET_TOOL_AXIS_SLIDER)
+			wlr_tablet_v2_tablet_tool_notify_slider(tool->v2, event->slider);
+		if (event->updated_axes & WLR_TABLET_TOOL_AXIS_WHEEL)
+			wlr_tablet_v2_tablet_tool_notify_wheel(tool->v2, event->wheel_delta, 0);
+	} else if (event->updated_axes & (WLR_TABLET_TOOL_AXIS_X | WLR_TABLET_TOOL_AXIS_Y)) {
+		wlserver.physical_cursor_move = true;
+		wlserver_mousewarp(x, y, event->time_msec, false);
+	}
+	bump_input_counter();
+}
+
+static void wlserver_handle_tablet_proximity(struct wl_listener *listener, void *data)
+{
+	wlserver_tablet *tablet = wl_container_of(listener, tablet, proximity);
+	auto *event = static_cast<struct wlr_tablet_tool_proximity_event *>(data);
+	auto *tool = wlserver_get_tablet_tool(event->tool);
+	if (!tool) return;
+	if (event->state == WLR_TABLET_TOOL_PROXIMITY_OUT) {
+		wlr_tablet_v2_tablet_tool_notify_proximity_out(tool->v2);
+		wlserver_tablet_release_pointer(tool, event->time_msec);
+	} else {
+		auto [x, y] = wlserver_absolute_coords(event->x, event->y);
+		if (wlserver_tablet_focus(tablet, tool))
+			wlr_tablet_v2_tablet_tool_notify_motion(tool->v2, x, y);
+		else
+			wlserver_mousewarp(x, y, event->time_msec, false);
+	}
+	bump_input_counter();
+}
+
+static void wlserver_handle_tablet_tip(struct wl_listener *listener, void *data)
+{
+	wlserver_tablet *tablet = wl_container_of(listener, tablet, tip);
+	auto *event = static_cast<struct wlr_tablet_tool_tip_event *>(data);
+	auto *tool = wlserver_get_tablet_tool(event->tool);
+	if (!tool) return;
+	bool down = event->state == WLR_TABLET_TOOL_TIP_DOWN;
+	auto [x, y] = wlserver_absolute_coords(event->x, event->y);
+	if (wlserver_tablet_focus(tablet, tool)) {
+		wlr_tablet_v2_tablet_tool_notify_motion(tool->v2, x, y);
+		if (down) wlr_tablet_v2_tablet_tool_notify_down(tool->v2);
+		else wlr_tablet_v2_tablet_tool_notify_up(tool->v2);
+	} else {
+		wlserver_mousewarp(x, y, event->time_msec, false);
+		wlserver_mousebutton(BTN_LEFT, down, event->time_msec);
+		tool->pointer_down = down;
+	}
+	bump_input_counter();
+}
+
+static void wlserver_handle_tablet_button(struct wl_listener *listener, void *data)
+{
+	wlserver_tablet *tablet = wl_container_of(listener, tablet, button);
+	auto *event = static_cast<struct wlr_tablet_tool_button_event *>(data);
+	auto *tool = wlserver_get_tablet_tool(event->tool);
+	if (!tool) return;
+	bool down = event->state == WLR_BUTTON_PRESSED;
+	if (wlserver_tablet_focus(tablet, tool)) {
+		wlr_tablet_v2_tablet_tool_notify_button(tool->v2, event->button,
+			down ? ZWP_TABLET_PAD_V2_BUTTON_STATE_PRESSED : ZWP_TABLET_PAD_V2_BUTTON_STATE_RELEASED);
+	} else {
+		uint32_t button = event->button == BTN_STYLUS2 ? BTN_MIDDLE : BTN_RIGHT;
+		wlserver_mousebutton(button, down, event->time_msec);
+		if (button == BTN_RIGHT) tool->pointer_right = down;
+		else tool->pointer_middle = down;
+	}
+	bump_input_counter();
+}
+
+static void wlserver_handle_tablet_destroy(struct wl_listener *listener, void *data)
+{
+	wlserver_tablet *tablet = wl_container_of(listener, tablet, destroy);
+	wl_list_remove(&tablet->axis.link);
+	wl_list_remove(&tablet->proximity.link);
+	wl_list_remove(&tablet->tip.link);
+	wl_list_remove(&tablet->button.link);
+	wl_list_remove(&tablet->destroy.link);
+	delete tablet;
+}
+
 // SteamOS-ARM: dual-screen handhelds (AYN Thor, AYANEO Pocket DS) have a
 // second touchscreen on the panel the main gamescope does not drive. Both are
 // I2C, so the heuristic above would map the second one onto the main screen and
@@ -664,6 +852,8 @@
 
