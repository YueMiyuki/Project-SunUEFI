+static void apply_touchscreen_orientation(GamescopePanelOrientation orientation, double *x, double *y);
+static std::pair<int, int> wlserver_get_cursor_bounds();
+static void wlserver_pointer_motion(double dx, double dy, double raw_dx, double raw_dy, uint32_t time);
+
+static void wlserver_perform_rel_pointer_motion(double dx, double dy, double raw_dx, double raw_dy, uint32_t time)
 {
 	assert( wlserver_is_lock_held() );
 
-	wlr_relative_pointer_manager_v1_send_relative_motion( wlserver.relative_pointer_manager, wlserver.wlr.seat, 0, unaccel_dx, unaccel_dy, unaccel_dx, unaccel_dy );
+	wlr_relative_pointer_manager_v1_send_relative_motion( wlserver.relative_pointer_manager,
+		wlserver.wlr.seat, uint64_t(time) * 1000, dx, dy, raw_dx, raw_dy );
 }
 
 static void wlserver_handle_pointer_motion(struct wl_listener *listener, void *data)
@@ -380,7 +388,27 @@
 
 	wlserver.physical_cursor_move = true;
 
-	wlserver_mousemotion(event->unaccel_dx, event->unaccel_dy, event->time_msec);
+	wlserver_pointer_motion(event->delta_x, event->delta_y,
+		event->unaccel_dx, event->unaccel_dy, event->time_msec);
+}
+
+static std::pair<double, double> wlserver_absolute_coords(double x, double y)
+{
+	if ( auto *connector = GetBackend()->GetCurrentConnector() )
+		apply_touchscreen_orientation(connector->GetCurrentOrientation(), &x, &y);
+	x = (x * g_nOutputWidth + focusedWindowOffsetX) * focusedWindowScaleX;
+	y = (y * g_nOutputHeight + focusedWindowOffsetY) * focusedWindowScaleY;
+	auto [width, height] = wlserver_get_cursor_bounds();
+	return {clamp(x, 0.0, width - 0.1), clamp(y, 0.0, height - 0.1)};
+}
+
+static void wlserver_handle_pointer_absolute(struct wl_listener *listener, void *data)
+{
+	auto *event = static_cast<struct wlr_pointer_motion_absolute_event *>(data);
+	auto [x, y] = wlserver_absolute_coords(event->x, event->y);
+	wlserver.physical_cursor_move = true;
+	wlserver_mousewarp(x, y, event->time_msec, false);
+	bump_input_counter();
 }
 
