From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] daemon: keep platform management available without tracefs

Kernel trace collection is a diagnostic feature. A kernel without tracefs
must not prevent desktop switching and the other platform services.

--- a/steamos-manager/src/daemon/root.rs
+++ b/steamos-manager/src/daemon/root.rs
@@ -124,8 +124,12 @@ impl DaemonContext for RootContext {
         self.state = state;
 
         let connection = daemon.get_connection();
-        let ftrace = Ftrace::init(&connection).await?;
-        daemon.add_service(ftrace);
+        match Ftrace::init(&connection).await {
+            Ok(ftrace) => {
+                daemon.add_service(ftrace);
+            }
+            Err(err) => tracing::warn!("Kernel trace collection unavailable: {err}"),
+        }
 
         let ip = DeckService::init(connection);
         daemon.add_service(ip);
