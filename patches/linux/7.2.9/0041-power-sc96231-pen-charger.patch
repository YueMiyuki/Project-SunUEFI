diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index 7f7a15d3ed6..1c54dc71e7b 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -33,11 +33,14 @@
 #include <linux/auxiliary_bus.h>
 #include <linux/completion.h>
 #include <linux/debugfs.h>
+#include <linux/delay.h>
 #include <linux/hex.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/power_supply.h>
 #include <linux/property.h>
+#include <linux/regulator/driver.h>
+#include <linux/of.h>
 #include <linux/seq_file.h>
 #include <linux/unaligned.h>
 #include <linux/workqueue.h>
@@ -52,6 +55,8 @@
 #define MCA_PROP_FCC		0x2005	/* charge current, mA */
 #define MCA_PROP_ICL		0x2008	/* input current limit, mA */
 #define MCA_PROP_PACK_TBAT	0x202a	/* degC */
+#define MCA_PROP_BOOST_ENABLE	0x200f
+#define MCA_PROP_BOOST_VOLTAGE	0x2010
 #define MCA_PROP_BUS_VOLT	0x20002	/* uV */
 #define MCA_PROP_BUS_CURR	0x20004	/* uA */
 #define MCA_PROP_REAL_TYPE	0x2000c	/* enum mca_real_type */
@@ -477,6 +482,10 @@ struct piano_mca {
 	unsigned long cp_off_at;	/* jiffies when the source went away */
 	unsigned long cp_on_at;		/* jiffies when it came */
 	bool auth_ok;		/* xiaomi-mipps-auth reported the adapter verified */
+	struct mutex pen_boost_lock;
+	bool pen_boost_on;
+	unsigned int pdr_generation;
+	unsigned int pen_boost_generation;
 	unsigned long auth_at;	/* jiffies when it did */
 	bool auth_tried;	/* direct charging asked for before any reset */
 	unsigned long hv_retry;	/* jiffies before which 9 V is not asked for */
@@ -527,6 +536,7 @@ static void piano_mca_pdr_notify(void *priv, int state)
 	struct piano_mca *mca = priv;
 
 	mca->service_up = state == SERVREG_SERVICE_STATE_UP;
+	mca->pdr_generation++;
 	/* A restarted ADSP is back on its defaults */
 	mca->icl_set_ma = 0;
 	mca->fcc_set_ma = 0;
@@ -744,6 +754,13 @@ static bool piano_mca_write_allowed(u32 prop, const void *data, size_t len)
 	u32 val = len == sizeof(u32) ? get_unaligned_le32(data) : 0;
 
 	switch (prop) {
+	case MCA_PROP_BOOST_ENABLE:
+		/* Wireless pen supply 1, client 2. Never select USB OTG. */
+		return len == sizeof(u32) && (val == 0x20100 || val == 0x20101);
+	case MCA_PROP_BOOST_VOLTAGE:
+		return len == sizeof(u32) &&
+		       (val == 0x11388 || val == 0x11450 || val == 0x1157c ||
+			val == 0x11770 || val == 0x11964);
 	case MCA_PROP_ICL:
 		return len == sizeof(u32) &&
 		       val >= MCA_ICL_MIN_MA && val <= MCA_ICL_HV_MAX_MA;
@@ -807,6 +824,127 @@ static u32 piano_mca_read_u32(struct piano_mca *mca, u32 prop)
 	return le32_to_cpu(val);
 }
 
+/*
+ * Piano's pen transmitter uses the ADSP's HBOOST output, not USB VBUS.
+ * Captured from the stock HyperOS 4 driver: source 1 in the voltage word,
+ * source 1/client 2 in enable; 5.0 -> 5.5 -> 6.0 -> 6.5 V, 20 ms steps.
+ * Disable only after the transmitter GPIO goes low, then 5.2 V / 10 ms.
+ * Expose this as a normal regulator for the SC96231 consumer.
+ */
+static int piano_mca_pen_boost_on(struct piano_mca *mca)
+{
+	unsigned int generation = READ_ONCE(mca->pdr_generation);
+	u32 mv;
+	int ret;
+
+	ret = piano_mca_write_u32(mca, MCA_PROP_BOOST_VOLTAGE, 0x11388);
+	if (ret)
+		return ret;
+	ret = piano_mca_write_u32(mca, MCA_PROP_BOOST_ENABLE, 0x20101);
+	if (ret)
+		return ret;
+
+	for (mv = 5500; mv <= 6500; mv += 500) {
+		msleep(20);
+		ret = piano_mca_write_u32(mca, MCA_PROP_BOOST_VOLTAGE,
+					  BIT(16) | mv);
+		if (ret) {
+			piano_mca_write_u32(mca, MCA_PROP_BOOST_ENABLE, 0x20100);
+			return ret;
+		}
+	}
+	mca->pen_boost_on = true;
+	mca->pen_boost_generation = generation;
+	return 0;
+}
+
+static int piano_mca_pen_boost_off(struct piano_mca *mca)
+{
+	int ret, voltage_ret;
+
+	voltage_ret = piano_mca_write_u32(mca, MCA_PROP_BOOST_VOLTAGE, 0x11450);
+	msleep(10);
+	ret = piano_mca_write_u32(mca, MCA_PROP_BOOST_ENABLE, 0x20100);
+	if (!ret)
+		mca->pen_boost_on = false;
+	if (voltage_ret)
+		dev_dbg(mca->dev, "pen boost ramp-down failed: %d\n", voltage_ret);
+	return ret;
+}
+
+static int piano_mca_pen_enable(struct regulator_dev *rdev)
+{
+	struct piano_mca *mca = rdev_get_drvdata(rdev);
+	int ret;
+
+	mutex_lock(&mca->pen_boost_lock);
+	ret = piano_mca_pen_boost_on(mca);
+	mutex_unlock(&mca->pen_boost_lock);
+	return ret;
+}
+
+static int piano_mca_pen_disable(struct regulator_dev *rdev)
+{
+	struct piano_mca *mca = rdev_get_drvdata(rdev);
+	int ret;
+
+	mutex_lock(&mca->pen_boost_lock);
+	ret = piano_mca_pen_boost_off(mca);
+	mutex_unlock(&mca->pen_boost_lock);
+	return ret;
+}
+
+static int piano_mca_pen_is_enabled(struct regulator_dev *rdev)
+{
+	struct piano_mca *mca = rdev_get_drvdata(rdev);
+
+	return READ_ONCE(mca->pen_boost_on) &&
+	       READ_ONCE(mca->pen_boost_generation) == READ_ONCE(mca->pdr_generation);
+}
+
+static const struct regulator_ops piano_mca_pen_regulator_ops = {
+	.enable = piano_mca_pen_enable,
+	.disable = piano_mca_pen_disable,
+	.is_enabled = piano_mca_pen_is_enabled,
+	.list_voltage = regulator_list_voltage_linear,
+};
+
+static const struct regulator_desc piano_mca_pen_regulator = {
+	.name = "piano-pen-boost",
+	.of_match = "pen-boost",
+	.regulators_node = "regulators",
+	.type = REGULATOR_VOLTAGE,
+	.owner = THIS_MODULE,
+	.ops = &piano_mca_pen_regulator_ops,
+	.n_voltages = 1,
+	.min_uV = 6500000,
+	.fixed_uV = 6500000,
+};
+
+static int piano_mca_register_pen_supply(struct piano_mca *mca)
+{
+	struct device_node *node = to_of_node(dev_fwnode(mca->dev));
+	struct device_node *regulators, *pen;
+	struct regulator_config cfg = {
+		.dev = mca->dev,
+		.driver_data = mca,
+		.of_node = node,
+	};
+	struct regulator_dev *rdev;
+
+	regulators = of_get_child_by_name(node, "regulators");
+	if (!regulators)
+		return 0;
+	pen = of_get_child_by_name(regulators, "pen-boost");
+	of_node_put(regulators);
+	if (!pen)
+		return 0;
+	of_node_put(pen);
+
+	rdev = devm_regulator_register(mca->dev, &piano_mca_pen_regulator, &cfg);
+	return PTR_ERR_OR_ZERO(rdev);
+}
+
 static const char *piano_mca_type_name(u32 type)
 {
 	return type < MCA_TYPE_MAX ? mca_real_type_names[type] : NULL;
@@ -1654,6 +1792,15 @@ static void piano_mca_poll(struct work_struct *work)
 	mca->online = online;
 	mca->real_type = real_type;
 
+	/* Restore an in-use pen rail after ADSP restarts. Its consumer will
+	 * stop the transmitter on a communication error in the meantime.
+	 */
+	mutex_lock(&mca->pen_boost_lock);
+	if (mca->pen_boost_on &&
+	    mca->pen_boost_generation != READ_ONCE(mca->pdr_generation))
+		piano_mca_pen_boost_on(mca);
+	mutex_unlock(&mca->pen_boost_lock);
+
 	if (!online) {
 		piano_mca_cp_learn_drop(mca);
 		piano_mca_cp_stop(mca, "detached");
@@ -2076,6 +2223,10 @@ static void piano_mca_stop(void *data)
 	bool cp;
 
 	cancel_delayed_work_sync(&mca->poll);
+	mutex_lock(&mca->pen_boost_lock);
+	if (mca->pen_boost_on)
+		piano_mca_pen_boost_off(mca);
+	mutex_unlock(&mca->pen_boost_lock);
 	cp = piano_mca_cp_active(mca);
 	piano_mca_cp_stop(mca, "unbind");
 	if (!mca->service_up)
@@ -2245,6 +2396,7 @@ static int piano_mca_probe(struct auxiliary_device *adev,
 	dev_info(dev, "MCA PD protocol version %u\n", mca->pd_protocol_version);
 	mca->hv_retry = jiffies;
 	mutex_init(&mca->lock);
+	mutex_init(&mca->pen_boost_lock);
 	init_completion(&mca->ack);
 	INIT_DELAYED_WORK(&mca->poll, piano_mca_poll);
 
@@ -2267,6 +2419,10 @@ static int piano_mca_probe(struct auxiliary_device *adev,
 	if (ret)
 		return ret;
 
+	ret = piano_mca_register_pen_supply(mca);
+	if (ret)
+		return ret;
+
 	mca->dbg = debugfs_create_dir("piano_mca", NULL);
 	debugfs_create_file("prop", 0200, mca->dbg, mca, &piano_mca_dbg_prop_fops);
 	debugfs_create_file("data", 0400, mca->dbg, mca, &piano_mca_dbg_data_fops);
diff --git a/drivers/power/supply/sc96231_charger.c b/drivers/power/supply/sc96231_charger.c
new file mode 100644
index 00000000000..812e0afd41d
--- /dev/null
+++ b/drivers/power/supply/sc96231_charger.c
@@ -0,0 +1,534 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Southchip SC96231 pen transmitter.
+ *
+ * Register protocol and sequencing recovered from the Piano HyperOS 4
+ * sc96231_tx and mca_wireless_revchg drivers, checked against a live charge
+ * cycle. Firmware remains on the chip; this driver does not program MTP.
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/pm_wakeup.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#define SC_FW_VERSION		0x0004
+#define SC_COMMAND		0x0100
+#define SC_IRQ_STATUS		0x0108
+#define SC_IRQ_CLEAR		0x010c
+#define SC_I2C_CHECK		0x01cc
+#define SC_PEN_SOC		0x01d0
+#define SC_PEN_MAC		0x01dc /* six bytes starting at offset 2 */
+#define SC_TX_DISABLE		BIT(18)
+#define SC_TX_ENABLE		BIT(19)
+#define SC_IRQ_EPT		BIT(15)
+#define SC_IRQ_RX_FOUND		BIT(16)
+#define SC_IRQ_FOD		BIT(17)
+#define SC_IRQ_CEP_TIMEOUT	BIT(19)
+#define SC_IRQ_RX_DETECTED	BIT(14)
+#define SC_IRQ_CONFIG		BIT(24)
+#define SC_IRQ_BLE_CONNECT	BIT(25)
+#define SC_IRQ_SOC		BIT(27)
+#define SC_IRQ_FAULTS		(SC_IRQ_EPT | SC_IRQ_FOD | SC_IRQ_CEP_TIMEOUT)
+
+struct sc96231 {
+	struct device *dev;
+	struct regmap *map;
+	struct regulator *vin;
+	struct gpio_desc *tx_enable;
+	struct gpio_desc *lp_enable;
+	struct gpio_descs *hall;
+	struct input_dev *dock;
+	struct power_supply *battery;
+	struct delayed_work work;
+	struct mutex lock;
+	int *hall_irqs;
+	int irq;
+	bool docked;
+	bool enabled;
+	bool present;
+	bool full;
+	bool fault;
+	bool stopping;
+	bool soc_valid;
+	int capacity;
+	unsigned long started;
+	unsigned long full_since;
+	char address[18];
+};
+
+static int sc96231_read(struct sc96231 *sc, u16 reg, void *data, size_t size)
+{
+	return regmap_raw_read(sc->map, reg, data, size);
+}
+
+static int sc96231_write_u32(struct sc96231 *sc, u16 reg, u32 value)
+{
+	__le32 data = cpu_to_le32(value);
+
+	return regmap_raw_write(sc->map, reg, &data, sizeof(data));
+}
+
+static void sc96231_stop(struct sc96231 *sc)
+{
+	int ret;
+
+	if (!sc->enabled)
+		return;
+	ret = sc96231_write_u32(sc, SC_COMMAND, SC_TX_DISABLE);
+	if (ret)
+		dev_dbg(sc->dev, "TX disable command failed: %d\n", ret);
+	/* Even an unresponsive transmitter must lose its enable and supply. */
+	gpiod_set_value_cansleep(sc->tx_enable, 0);
+	ret = regulator_disable(sc->vin);
+	if (ret)
+		dev_warn(sc->dev, "pen supply disable failed: %d\n", ret);
+	else
+		sc->enabled = false;
+}
+
+static int sc96231_start(struct sc96231 *sc)
+{
+	u8 check[4];
+	__le32 version, pending;
+	int ret;
+
+	ret = regulator_enable(sc->vin);
+	if (ret)
+		return ret == -ENODEV ? -EPROBE_DEFER : ret;
+	sc->enabled = true;
+	gpiod_set_value_cansleep(sc->tx_enable, 1);
+	msleep(20);
+
+	/* Stock uses the last byte of this aligned word as an I2C handshake. */
+	ret = sc96231_read(sc, SC_I2C_CHECK, check, sizeof(check));
+	if (ret)
+		goto fail;
+	check[3] = 0x55;
+	ret = regmap_raw_write(sc->map, SC_I2C_CHECK, check, sizeof(check));
+	if (ret)
+		goto fail;
+	msleep(20);
+	ret = sc96231_read(sc, SC_I2C_CHECK, check, sizeof(check));
+	if (ret)
+		goto fail;
+	if (check[3] != 0x55) {
+		ret = -EIO;
+		goto fail;
+	}
+	ret = sc96231_read(sc, SC_FW_VERSION, &version, sizeof(version));
+	if (ret)
+		goto fail;
+	if (!version || version == cpu_to_le32(U32_MAX)) {
+		ret = -ENODATA;
+		goto fail;
+	}
+	ret = sc96231_read(sc, SC_IRQ_STATUS, &pending, sizeof(pending));
+	if (ret)
+		goto fail;
+	if (pending) {
+		ret = sc96231_write_u32(sc, SC_IRQ_CLEAR, le32_to_cpu(pending));
+		if (ret)
+			goto fail;
+	}
+	ret = sc96231_write_u32(sc, SC_COMMAND, SC_TX_ENABLE);
+	if (ret)
+		goto fail;
+	sc->started = jiffies;
+	dev_info(sc->dev, "pen transmitter enabled, firmware %#x\n",
+		 le32_to_cpu(version));
+	return 0;
+fail:
+	sc96231_stop(sc);
+	return ret;
+}
+
+static int sc96231_docked(struct sc96231 *sc)
+{
+	unsigned int i;
+	int value, attached = 0;
+
+	for (i = 0; i < sc->hall->ndescs; i++) {
+		value = gpiod_get_value_cansleep(sc->hall->desc[i]);
+		if (value < 0)
+			return value;
+		attached |= value;
+	}
+	return attached;
+}
+
+static int sc96231_update_pen(struct sc96231 *sc, u32 irq)
+{
+	u8 raw[8], soc[4];
+	int ret, i;
+	bool nonzero = false, not_ff = false;
+
+	if (!sc->present && !(irq & (SC_IRQ_CONFIG | SC_IRQ_BLE_CONNECT | SC_IRQ_SOC)))
+		return 0;
+	ret = sc96231_read(sc, SC_PEN_MAC, raw, sizeof(raw));
+	if (ret)
+		return ret;
+	for (i = 2; i < 8; i++) {
+		nonzero |= raw[i] != 0;
+		not_ff |= raw[i] != 0xff;
+	}
+	if (nonzero && not_ff) {
+		/* The chip stores the Bluetooth address least-significant byte
+		 * first; stock publishes the resulting u64 with "%llx".
+		 */
+		snprintf(sc->address, sizeof(sc->address), "%pMR", raw + 2);
+		sc->present = true;
+	}
+
+	ret = sc96231_read(sc, SC_PEN_SOC, soc, sizeof(soc));
+	if (ret)
+		return ret;
+	/* Zero before a charge-status interrupt means no report yet. */
+	if ((soc[0] || (irq & SC_IRQ_SOC)) && (soc[0] & 0x7f) <= 100) {
+		sc->capacity = soc[0] & 0x7f;
+		sc->soc_valid = true;
+		sc->full = soc[0] & BIT(7);
+		/* Stock stops after 18 consecutive ten-second reports at 100%,
+		 * even if the receiver never raises its explicit full flag.
+		 */
+		if (sc->capacity == 100) {
+			if (!sc->full_since)
+				sc->full_since = jiffies;
+			else if (time_after_eq(jiffies, sc->full_since + 180 * HZ))
+				sc->full = true;
+		} else {
+			sc->full_since = 0;
+		}
+	}
+	return 0;
+}
+
+static void sc96231_work(struct work_struct *work)
+{
+	struct sc96231 *sc = container_of(to_delayed_work(work),
+					struct sc96231, work);
+	__le32 raw_irq;
+	u32 irq = 0;
+	int attached, ret;
+
+	mutex_lock(&sc->lock);
+	if (sc->stopping)
+		goto out;
+	attached = sc96231_docked(sc);
+	if (attached < 0)
+		goto poll;
+	if (attached != sc->docked) {
+		sc->docked = attached;
+		input_report_switch(sc->dock, SW_PEN_INSERTED, attached);
+		input_sync(sc->dock);
+		if (!attached) {
+			sc96231_stop(sc);
+			sc->present = false;
+			sc->full = false;
+			sc->fault = false;
+			sc->soc_valid = false;
+			sc->full_since = 0;
+			/* Retain the discovered address for reconnect after removal. */
+			goto notify;
+		}
+	}
+	if (!sc->docked || sc->fault || sc->full) {
+		sc96231_stop(sc);
+		goto notify;
+	}
+	if (!sc->enabled) {
+		ret = sc96231_start(sc);
+		if (ret == -EPROBE_DEFER)
+			goto poll;
+		if (ret) {
+			dev_err(sc->dev, "pen transmitter start failed: %d\n", ret);
+			sc->fault = true;
+			goto notify;
+		}
+		goto poll;
+	}
+
+	ret = sc96231_read(sc, SC_IRQ_STATUS, &raw_irq, sizeof(raw_irq));
+	if (ret)
+		goto failed;
+	irq = le32_to_cpu(raw_irq);
+	if (irq) {
+		ret = sc96231_write_u32(sc, SC_IRQ_CLEAR, irq);
+		if (ret)
+			goto failed;
+	}
+	if (irq & (SC_IRQ_RX_FOUND | SC_IRQ_RX_DETECTED | SC_IRQ_CONFIG))
+		sc->present = true;
+	ret = sc96231_update_pen(sc, irq);
+	if (ret)
+		goto failed;
+	if (sc->full) {
+		sc96231_stop(sc);
+		goto notify;
+	}
+	if (irq & SC_IRQ_FAULTS) {
+		ret = -EREMOTEIO;
+		goto failed;
+	}
+	/* Same 20-second no-receiver timeout as the original charging stack. */
+	if (!sc->present && time_after(jiffies, sc->started + 20 * HZ)) {
+		ret = -ETIMEDOUT;
+		goto failed;
+	}
+	goto notify;
+failed:
+	dev_warn(sc->dev, "pen transmitter stopped: %d, IRQ %#x\n", ret, irq);
+	sc->fault = true;
+	sc96231_stop(sc);
+notify:
+	power_supply_changed(sc->battery);
+poll:
+	if (!sc->stopping &&
+	    (sc->enabled || (sc->docked && !sc->fault && !sc->full)))
+		mod_delayed_work(system_freezable_wq, &sc->work, HZ);
+out:
+	mutex_unlock(&sc->lock);
+}
+
+static irqreturn_t sc96231_irq(int irq, void *data)
+{
+	struct sc96231 *sc = data;
+
+	if (!READ_ONCE(sc->stopping))
+		mod_delayed_work(system_freezable_wq, &sc->work, msecs_to_jiffies(20));
+	return IRQ_HANDLED;
+}
+
+static int sc96231_get_property(struct power_supply *psy,
+			       enum power_supply_property prop,
+			       union power_supply_propval *val)
+{
+	struct sc96231 *sc = power_supply_get_drvdata(psy);
+	int ret = 0;
+
+	mutex_lock(&sc->lock);
+	switch (prop) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = sc->present;
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		val->intval = POWER_SUPPLY_SCOPE_DEVICE;
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		if (!sc->present)
+			val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+		else if (sc->full)
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+		else if (sc->enabled && !sc->fault)
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		if (!sc->soc_valid)
+			ret = -ENODATA;
+		else
+			val->intval = sc->capacity;
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "Wireless pen";
+		break;
+	case POWER_SUPPLY_PROP_SERIAL_NUMBER:
+		if (!sc->address[0])
+			ret = -ENODATA;
+		else
+			val->strval = sc->address;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&sc->lock);
+	return ret;
+}
+
+static const enum power_supply_property sc96231_properties[] = {
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_SCOPE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+	POWER_SUPPLY_PROP_SERIAL_NUMBER,
+};
+
+static const struct power_supply_desc sc96231_supply = {
+	.name = "sc96231-pen",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = sc96231_properties,
+	.num_properties = ARRAY_SIZE(sc96231_properties),
+	.get_property = sc96231_get_property,
+};
+
+static void sc96231_quiesce(void *data)
+{
+	struct sc96231 *sc = data;
+
+	WRITE_ONCE(sc->stopping, true);
+	cancel_delayed_work_sync(&sc->work);
+	mutex_lock(&sc->lock);
+	sc96231_stop(sc);
+	mutex_unlock(&sc->lock);
+}
+
+static const struct regmap_config sc96231_regmap = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+	.reg_format_endian = REGMAP_ENDIAN_BIG,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int sc96231_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct power_supply_config cfg = {};
+	struct sc96231 *sc;
+	unsigned int i;
+	int ret;
+
+	sc = devm_kzalloc(dev, sizeof(*sc), GFP_KERNEL);
+	if (!sc)
+		return -ENOMEM;
+	sc->dev = dev;
+	sc->irq = client->irq;
+	i2c_set_clientdata(client, sc);
+	mutex_init(&sc->lock);
+	INIT_DELAYED_WORK(&sc->work, sc96231_work);
+	sc->map = devm_regmap_init_i2c(client, &sc96231_regmap);
+	if (IS_ERR(sc->map))
+		return PTR_ERR(sc->map);
+	sc->vin = devm_regulator_get(dev, "vin");
+	if (IS_ERR(sc->vin))
+		return dev_err_probe(dev, PTR_ERR(sc->vin), "pen power supply\n");
+	sc->tx_enable = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(sc->tx_enable))
+		return dev_err_probe(dev, PTR_ERR(sc->tx_enable), "TX enable GPIO\n");
+	sc->lp_enable = devm_gpiod_get_optional(dev, "lp-enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(sc->lp_enable))
+		return PTR_ERR(sc->lp_enable);
+	sc->hall = devm_gpiod_get_array(dev, "hall", GPIOD_IN);
+	if (IS_ERR(sc->hall))
+		return dev_err_probe(dev, PTR_ERR(sc->hall), "pen Hall GPIOs\n");
+	sc->hall_irqs = devm_kcalloc(dev, sc->hall->ndescs,
+				    sizeof(*sc->hall_irqs), GFP_KERNEL);
+	if (!sc->hall_irqs)
+		return -ENOMEM;
+	sc->dock = devm_input_allocate_device(dev);
+	if (!sc->dock)
+		return -ENOMEM;
+	sc->dock->name = "Xiaomi Piano Pen Dock";
+	sc->dock->id.bustype = BUS_I2C;
+	input_set_capability(sc->dock, EV_SW, SW_PEN_INSERTED);
+	ret = input_register_device(sc->dock);
+	if (ret)
+		return ret;
+	cfg.drv_data = sc;
+	cfg.fwnode = dev_fwnode(dev);
+	sc->battery = devm_power_supply_register(dev, &sc96231_supply, &cfg);
+	if (IS_ERR(sc->battery))
+		return PTR_ERR(sc->battery);
+	ret = devm_add_action_or_reset(dev, sc96231_quiesce, sc);
+	if (ret)
+		return ret;
+	/* IRQ resources are registered last, so devres frees them before work. */
+	for (i = 0; i < sc->hall->ndescs; i++) {
+		ret = gpiod_to_irq(sc->hall->desc[i]);
+		if (ret < 0)
+			return ret;
+		sc->hall_irqs[i] = ret;
+		ret = devm_request_threaded_irq(dev, ret, NULL, sc96231_irq,
+				IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
+				"sc96231-hall", sc);
+		if (ret)
+			return ret;
+	}
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, sc96231_irq,
+				       IRQF_ONESHOT, "sc96231", sc);
+	if (ret)
+		return ret;
+	if (device_property_read_bool(dev, "wakeup-source")) {
+		ret = devm_device_init_wakeup(dev);
+		if (ret)
+			return ret;
+	}
+	mod_delayed_work(system_freezable_wq, &sc->work, 0);
+	return 0;
+}
+
+static void sc96231_shutdown(struct i2c_client *client)
+{
+	sc96231_quiesce(i2c_get_clientdata(client));
+}
+
+static int sc96231_suspend(struct device *dev)
+{
+	struct sc96231 *sc = dev_get_drvdata(dev);
+	int ret;
+	unsigned int i;
+
+	if (!device_may_wakeup(dev))
+		return 0;
+	ret = enable_irq_wake(sc->irq);
+	if (ret)
+		return ret;
+	for (i = 0; i < sc->hall->ndescs; i++) {
+		ret = enable_irq_wake(sc->hall_irqs[i]);
+		if (ret) {
+			while (i--)
+				disable_irq_wake(sc->hall_irqs[i]);
+			disable_irq_wake(sc->irq);
+			return ret;
+		}
+	}
+	return 0;
+}
+
+static int sc96231_resume(struct device *dev)
+{
+	struct sc96231 *sc = dev_get_drvdata(dev);
+	unsigned int i;
+
+	if (device_may_wakeup(dev)) {
+		for (i = 0; i < sc->hall->ndescs; i++)
+			disable_irq_wake(sc->hall_irqs[i]);
+		disable_irq_wake(sc->irq);
+	}
+	mod_delayed_work(system_freezable_wq, &sc->work, 0);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(sc96231_pm_ops, sc96231_suspend, sc96231_resume);
+
+static const struct of_device_id sc96231_of_match[] = {
+	{ .compatible = "southchip,sc96231" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, sc96231_of_match);
+
+static struct i2c_driver sc96231_driver = {
+	.driver = {
+		.name = "sc96231",
+		.of_match_table = sc96231_of_match,
+		.pm = pm_sleep_ptr(&sc96231_pm_ops),
+	},
+	.probe = sc96231_probe,
+	.shutdown = sc96231_shutdown,
+};
+module_i2c_driver(sc96231_driver);
+
+MODULE_DESCRIPTION("Southchip SC96231 wireless pen charger");
+MODULE_AUTHOR("slwyts <slwyts@foxmail.com>");
+MODULE_LICENSE("GPL");
