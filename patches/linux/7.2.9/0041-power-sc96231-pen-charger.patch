From f77aff981ba1f054ffb659a1e15eef44af19669f Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 06:04:00 +0800
Subject: [PATCH] power: supply: add SC96231 pen charger with MCA boost
 regulator

---
 .../power/supply/southchip,sc96231.yaml       |  67 +++
 .../bindings/soc/qcom/qcom,pmic-glink.yaml    |  14 +
 drivers/power/supply/Kconfig                  |  11 +-
 drivers/power/supply/Makefile                 |   1 +
 drivers/power/supply/piano_mca.c              | 156 +++++
 drivers/power/supply/sc96231_charger.c        | 534 ++++++++++++++++++
 6 files changed, 782 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/power/supply/southchip,sc96231.yaml
 create mode 100644 drivers/power/supply/sc96231_charger.c

diff --git a/Documentation/devicetree/bindings/power/supply/southchip,sc96231.yaml b/Documentation/devicetree/bindings/power/supply/southchip,sc96231.yaml
new file mode 100644
index 00000000000..b505ee2a14a
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/southchip,sc96231.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/southchip,sc96231.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Southchip SC96231 wireless pen transmitter
+
+maintainers:
+  - slwyts <slwyts@foxmail.com>
+
+description: |
+  Wireless power transmitter with an I2C control interface. Hall sensors
+  detect the magnetic pen attachment; the charging link reports the receiver
+  battery level and Bluetooth address. The supply regulator owns voltage
+  sequencing. The chip's installed firmware owns the wireless power protocol.
+
+properties:
+  compatible:
+    const: southchip,sc96231
+  reg:
+    maxItems: 1
+  interrupts:
+    maxItems: 1
+  vin-supply: true
+  enable-gpios:
+    maxItems: 1
+    description: Transmitter enable signal.
+  lp-enable-gpios:
+    maxItems: 1
+    description: Optional low-power control held asserted during operation.
+  hall-gpios:
+    minItems: 1
+    maxItems: 2
+    description: Active means pen attached; either sensor may detect the pen.
+  wakeup-source: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - vin-supply
+  - enable-gpios
+  - hall-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+        charger@38 {
+            compatible = "southchip,sc96231";
+            reg = <0x38>;
+            vin-supply = <&pen_boost>;
+            enable-gpios = <&tlmm 14 GPIO_ACTIVE_HIGH>;
+            lp-enable-gpios = <&tlmm 99 GPIO_ACTIVE_HIGH>;
+            hall-gpios = <&tlmm 200 GPIO_ACTIVE_LOW>,
+                         <&tlmm 196 GPIO_ACTIVE_LOW>;
+            interrupt-parent = <&tlmm>;
+            interrupts = <78 IRQ_TYPE_EDGE_FALLING>;
+            wakeup-source;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
index 4e8728c98b9..7c146236e73 100644
--- a/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
@@ -65,6 +65,20 @@ properties:
       2, inserting one property before the data-role and source-PDO controls.
       This must match the ADSP firmware shipped with the operating system.
 
+  regulators:
+    type: object
+    additionalProperties: false
+    description: Xiaomi MCA firmware-controlled pen transmitter supply.
+    properties:
+      pen-boost:
+        $ref: /schemas/regulator/regulator.yaml#
+        unevaluatedProperties: false
+        properties:
+          regulator-min-microvolt:
+            const: 6500000
+          regulator-max-microvolt:
+            const: 6500000
+
   '#size-cells':
     const: 0
 
diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index 3121804e119..d5f91b4d268 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -210,7 +210,7 @@ config BATTERY_PMU
 
 config BATTERY_PIANO_MCA
 	tristate "Xiaomi MCA ADSP charger/battery telemetry (Pad 8 Pro)"
-	depends on QCOM_PMIC_GLINK
+	depends on QCOM_PMIC_GLINK && REGULATOR
 	help
 	  Say Y here to enable telemetry from the Xiaomi Pad 8 Pro charger
 	  stack, which the ADSP firmware exposes through Xiaomi's MCA property
@@ -1205,4 +1205,13 @@ config MACSMC_POWER
 
 	  Say Y or M here if you have an Apple Silicon based Mac.
 
+config CHARGER_SC96231
+	tristate "Southchip SC96231 wireless pen transmitter"
+	depends on I2C && GPIOLIB && INPUT && REGULATOR
+	select REGMAP_I2C
+	help
+	  Supply and control an SC96231 pen transmitter using standard regulator,
+	  input switch and power supply interfaces. The device's installed
+	  firmware handles the wireless link; no firmware update is performed.
+
 endif # POWER_SUPPLY
