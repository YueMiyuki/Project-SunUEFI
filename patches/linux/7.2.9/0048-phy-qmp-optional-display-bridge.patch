From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] phy: qcom-qmp: register the display bridge only for a connected graph

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 5b278fd54a1..97cb84e3a59 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -4899,9 +4899,14 @@ static int qmp_combo_probe(struct platform_device *pdev)
 		}
 	}
 
-	ret = drm_aux_bridge_register(dev);
-	if (ret)
-		goto err_node_put;
+	/* A USB-only board description has no downstream display bridge.
+	 * Keep USB PHY support without creating an unresolvable DRM device.
+	 */
+	if (of_graph_is_present(dev->of_node)) {
+		ret = drm_aux_bridge_register(dev);
+		if (ret)
+			goto err_node_put;
+	}
 
 	pm_runtime_set_active(dev);
 	ret = devm_pm_runtime_enable(dev);
