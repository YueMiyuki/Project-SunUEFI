diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.c
new file mode 100644
index 00000000000..3dbd2494b5f
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.c
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Ordinary IGC v5 LUTBUS layout from Qualcomm's published display driver. */
+#include <linux/bitops.h>
+#include <linux/byteorder/generic.h>
+#include <linux/errno.h>
+#include <drm/drm_color_mgmt.h>
+
+#include "dpu_hw_gcv2.h"
+#include "dpu_hw_igcv5.h"
+
+#define REGDMA_V3_DECODE_SELECT 0x18180114
+#define REGDMA_SINGLE_WRITE BIT(28)
+#define REGDMA_LUTBUS_WRITE (BIT(30) | BIT(29))
+#define IGC_CONTROL_OFFSET 0x4
+#define IGC_ENABLE BIT(8)
+#define IGC_TRANSFER_WORDS 3
+#define IGC_TRANSFER_COUNT (DPU_IGCV5_DATA_WORDS / IGC_TRANSFER_WORDS)
+
+static u16 igcv5_component(const struct drm_color_lut *lut, unsigned int index)
+{
+	unsigned int entry = index / 3;
+
+	if (entry >= DPU_IGCV5_LUT_SIZE)
+		return 0; /* Pad the odd endpoint to a complete LUTBUS transfer. */
+	switch (index % 3) {
+	case 0:
+		return lut[entry].red;
+	case 1:
+		return lut[entry].green;
+	default:
+		return lut[entry].blue;
+	}
+}
+
+int dpu_hw_igcv5_pack_regdma(__le32 *words, size_t capacity,
+			   u32 dspp_mask, const struct drm_color_lut *lut)
+{
+	unsigned int i, n = 0;
+	unsigned int required = lut ? DPU_IGCV5_LUT_WORDS : 4;
+
+	if (!words || !dspp_mask || (dspp_mask & ~DPU_GCV2_DSPP_MASK))
+		return -EINVAL;
+	if (capacity < required)
+		return -ENOSPC;
+	words[n++] = cpu_to_le32(REGDMA_V3_DECODE_SELECT);
+	words[n++] = cpu_to_le32(dspp_mask);
+	if (lut) {
+		/* LUTBUS block IGC=0, table select=0, three DWORDs per transfer.
+		 * Ordinary v5 uses the full 16-bit R/G/B, without the v4 <<4.
+		 * Preserve the standard endpoint including zero; the vendor API's
+		 * zero-as-default-last sentinel is not part of the DRM LUT ABI.
+		 */
+		words[n++] = cpu_to_le32(REGDMA_LUTBUS_WRITE);
+		words[n++] = cpu_to_le32((IGC_TRANSFER_WORDS << 16) | IGC_TRANSFER_COUNT);
+		for (i = 0; i < DPU_IGCV5_DATA_WORDS; i++)
+			words[n++] = cpu_to_le32(igcv5_component(lut, i * 2) |
+					((u32)igcv5_component(lut, i * 2 + 1) << 16));
+		/* Published LUTBUS workaround: three real NO_OP opcodes. */
+		words[n++] = 0;
+		words[n++] = 0;
+		words[n++] = 0;
+	}
+	words[n++] = cpu_to_le32(REGDMA_SINGLE_WRITE |
+				(DPU_IGCV5_REG_BASE + IGC_CONTROL_OFFSET));
+	/* High precision and dither have no standard encoding in this backend. */
+	words[n++] = cpu_to_le32(lut ? IGC_ENABLE : 0);
+	return n;
+}
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.h
new file mode 100644
index 00000000000..4155aa61904
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _DPU_HW_IGCV5_H
+#define _DPU_HW_IGCV5_H
+
+#include <linux/types.h>
+
+struct drm_color_lut;
+
+#define DPU_IGCV5_LUT_SIZE 257
+#define DPU_IGCV5_REG_BASE 0x1260
+/* 258 padded RGB triplets / two triplets per LUTBUS transfer. */
+#define DPU_IGCV5_DATA_WORDS 387
+#define DPU_IGCV5_LUT_WORDS (2 + 2 + DPU_IGCV5_DATA_WORDS + 3 + 2)
+
+/* CPU command preparation only. A non-NULL LUT has exactly 257 DRM entries.
+ * The caller owns the buffer, mapping, queue and completion/reset lifetime.
+ */
+int dpu_hw_igcv5_pack_regdma(__le32 *words, size_t capacity,
+			   u32 dspp_mask, const struct drm_color_lut *lut);
+
+#endif
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
index ff6082b1d79..6b9d070c241 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
@@ -14,6 +14,7 @@
 #include "msm_drv.h"
 #include "msm_gem.h"
 #include "dpu_hw_gcv2.h"
+#include "dpu_hw_igcv5.h"
 #include "dpu_hw_vbif.h"
 #include "dpu_kms.h"
 #include "dpu_hw_dspp.h"
