+	/* Complete GC/IGC state in one shared REGDMA submission. */
+	int (*setup_color)(struct dpu_hw_dspp *ctx, struct dpu_hw_gc_lut *gc_lut,
+			   const struct drm_color_lut *igc_lut,
+			   struct dpu_hw_ctl *ctl, u32 dspp_mask);
+
 };
 
