From fa53499be18934d90eae372805b57ad93844151f Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 06:04:00 +0800
Subject: [PATCH] input: nt36532e: defer pen-mode requests until panel resume

---
 drivers/input/touchscreen/nt36532e/nt36xxx.c | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/drivers/input/touchscreen/nt36532e/nt36xxx.c b/drivers/input/touchscreen/nt36532e/nt36xxx.c
index 92d621f95b7..309d623fd61 100644
--- a/drivers/input/touchscreen/nt36532e/nt36xxx.c
+++ b/drivers/input/touchscreen/nt36532e/nt36xxx.c
@@ -550,7 +550,6 @@ static ssize_t nvt_thp_stylus_write(struct file *file,
 				    const char __user *buf, size_t count,
 				    loff_t *ppos)
 {
-	bool irq_was_enabled;
 	u8 mode;
 	int ret;
 
@@ -563,18 +562,24 @@ static ssize_t nvt_thp_stylus_write(struct file *file,
 	if (mode != 0 && mode != 1 && mode != 3)
 		return -EINVAL;
 
-	irq_was_enabled = READ_ONCE(ts->irq_enabled);
-	if (irq_was_enabled)
-		nvt_irq_enable(false);
+	/* Own one disable reference; do not overwrite a suspend's IRQ state. */
+	disable_irq(ts->client->irq);
 	mutex_lock(&ts->lock);
+	if (!bTouchIsAwake || ts->dev_pm_suspend || !ts->thp_firmware_ready ||
+	    ts->ic_state == NVT_IC_SUSPEND_IN || ts->ic_state == NVT_IC_SUSPEND_OUT) {
+		/* The firmware restore path applies the desired mode on wake. */
+		ts->thp_stylus_mode = mode;
+		ret = 0;
+		goto out;
+	}
 	ret = nvt_set_custom_cmd(0x04, mode != 0);
 	if (!ret && mode)
 		ret = nvt_thp_set_pen_switch(mode);
 	if (!ret)
 		ts->thp_stylus_mode = mode;
+out:
 	mutex_unlock(&ts->lock);
-	if (irq_was_enabled)
-		nvt_irq_enable(true);
+	enable_irq(ts->client->irq);
 
 	if (ret)
 		return ret;
-- 
