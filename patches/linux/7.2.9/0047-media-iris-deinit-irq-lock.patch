From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] media: iris: quiesce the IRQ thread before locking during deinit

diff --git a/drivers/media/platform/qcom/iris/iris_core.c b/drivers/media/platform/qcom/iris/iris_core.c
index 8c335dbfce1..6a72885757a 100644
--- a/drivers/media/platform/qcom/iris/iris_core.c
+++ b/drivers/media/platform/qcom/iris/iris_core.c
@@ -16,6 +16,11 @@ void iris_core_deinit(struct iris_core *core)
 
 	ret = pm_runtime_resume_and_get(core->dev);
 
+	/* The IRQ thread takes core->lock. Quiesce it before taking that lock,
+	 * otherwise power_off's disable_irq() can wait for a thread blocked on
+	 * us. Keep this extra disable balanced independently of power state.
+	 */
+	disable_irq(core->irq);
 	mutex_lock(&core->lock);
 	if (core->state != IRIS_CORE_DEINIT) {
 		iris_fw_unload(core);
@@ -27,6 +32,7 @@ void iris_core_deinit(struct iris_core *core)
 		core->state = IRIS_CORE_DEINIT;
 	}
 	mutex_unlock(&core->lock);
+	enable_irq(core->irq);
 
 	if (!ret)
 		pm_runtime_put_sync(core->dev);
