From e2ae3dd8bd50ee5a70b390d2d82898af5a603254 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 06:59:45 +0800
Subject: [PATCH] drm/msm: map uniform degamma to IGCv5 high-precision grids

Piano factory QDCM sRGB samples match the 0..1/256 main grid and 0..127/1024 dark grid exactly, with its independent gamma-2.2 curve agreeing within one code. Export 1025 uniform DRM samples, select both grids, and enlarge the shared DMA buffer for the longer LUT. Dither and HDR behavior remain separate.
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.c | 20 ++++++++++++++++----
 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.h | 11 +++++++----
 drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c   |  2 +-
 3 files changed, 24 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.c
index 3dbd2494b5f..b083083ba48 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.c
@@ -1,5 +1,5 @@
 // SPDX-License-Identifier: GPL-2.0-only
-/* Ordinary IGC v5 LUTBUS layout from Qualcomm's published display driver. */
+/* IGC v5 LUTBUS layout from Qualcomm's published display driver. */
 #include <linux/bitops.h>
 #include <linux/byteorder/generic.h>
 #include <linux/errno.h>
@@ -13,6 +13,7 @@
 #define REGDMA_LUTBUS_WRITE (BIT(30) | BIT(29))
 #define IGC_CONTROL_OFFSET 0x4
 #define IGC_ENABLE BIT(8)
+#define IGC_HIGH_PRECISION BIT(16)
 #define IGC_TRANSFER_WORDS 3
 #define IGC_TRANSFER_COUNT (DPU_IGCV5_DATA_WORDS / IGC_TRANSFER_WORDS)
 
@@ -20,8 +21,19 @@ static u16 igcv5_component(const struct drm_color_lut *lut, unsigned int index)
 {
 	unsigned int entry = index / 3;
 
-	if (entry >= DPU_IGCV5_LUT_SIZE)
+	if (entry >= DPU_IGCV5_HW_ENTRIES)
 		return 0; /* Pad the odd endpoint to a complete LUTBUS transfer. */
+	/*
+	 * Hardware main grid: 0, 1/256, ... 1. Dark grid: 0..127/1024.
+	 * The stock Piano QDCM sRGB table matches the IEC sRGB EOTF on
+	 * these grids exactly; its independent gamma-2.2 table agrees within
+	 * one 16-bit code. Expose a uniform 1025-point DRM LUT and select
+	 * samples, rather than exposing 385 nonuniform points to userspace.
+	 */
+	if (entry < DPU_IGCV5_MAIN_ENTRIES)
+		entry *= 4;
+	else
+		entry -= DPU_IGCV5_MAIN_ENTRIES;
 	switch (index % 3) {
 	case 0:
 		return lut[entry].red;
@@ -62,7 +74,7 @@ int dpu_hw_igcv5_pack_regdma(__le32 *words, size_t capacity,
 	}
 	words[n++] = cpu_to_le32(REGDMA_SINGLE_WRITE |
 				(DPU_IGCV5_REG_BASE + IGC_CONTROL_OFFSET));
-	/* High precision and dither have no standard encoding in this backend. */
-	words[n++] = cpu_to_le32(lut ? IGC_ENABLE : 0);
+	/* Dither remains disabled; this mode changes LUT sampling, not DSC bpc. */
+	words[n++] = cpu_to_le32(lut ? IGC_ENABLE | IGC_HIGH_PRECISION : 0);
 	return n;
 }
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.h
index 4155aa61904..d4b34e3d30c 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_igcv5.h
@@ -6,13 +6,16 @@
 
 struct drm_color_lut;
 
-#define DPU_IGCV5_LUT_SIZE 257
+#define DPU_IGCV5_LUT_SIZE 1025
 #define DPU_IGCV5_REG_BASE 0x1260
-/* 258 padded RGB triplets / two triplets per LUTBUS transfer. */
-#define DPU_IGCV5_DATA_WORDS 387
+#define DPU_IGCV5_MAIN_ENTRIES 257
+#define DPU_IGCV5_DARK_ENTRIES 128
+#define DPU_IGCV5_HW_ENTRIES (DPU_IGCV5_MAIN_ENTRIES + DPU_IGCV5_DARK_ENTRIES)
+/* 386 padded RGB triplets / two triplets per LUTBUS transfer. */
+#define DPU_IGCV5_DATA_WORDS 579
 #define DPU_IGCV5_LUT_WORDS (2 + 2 + DPU_IGCV5_DATA_WORDS + 3 + 2)
 
-/* CPU command preparation only. A non-NULL LUT has exactly 257 DRM entries.
+/* CPU command preparation only. A non-NULL LUT has exactly 1025 DRM entries.
  * The caller owns the buffer, mapping, queue and completion/reset lifetime.
  */
 int dpu_hw_igcv5_pack_regdma(__le32 *words, size_t capacity,
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
index 6b9d070c241..7b2839e0370 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
@@ -37,7 +37,7 @@
 #define REGDMA_LAST BIT(24)
 #define REGDMA_CMD_WORDS GENMASK(13, 0)
 #define REGDMA_ALIGN 256
-#define REGDMA_BUFFER_SIZE SZ_8K
+#define REGDMA_BUFFER_SIZE SZ_16K
 #define REGDMA_LAST_SIZE (2 * sizeof(u32))
 
 struct dpu_lutdma {
-- 
