From 3bfd19bcbbb197f81566402196017805707d3570 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 02:36:19 +0800
Subject: [PATCH] backlight: ktz8866: wait for the configured disable ramp

Clearing BL_EN starts the programmed LED fade. Returning immediately lets the panel and video link stop while the backlight is still visible. Wait for the slower chip in a mirrored pair, including an inherited bootloader ramp configuration, and propagate register access errors. Write the target brightness before enabling the sinks.
---
 drivers/video/backlight/ktz8866.c | 50 ++++++++++++++++++++++++++-----
 1 file changed, 42 insertions(+), 8 deletions(-)

diff --git a/drivers/video/backlight/ktz8866.c b/drivers/video/backlight/ktz8866.c
index 709109142ec..c237fe1aeee 100644
--- a/drivers/video/backlight/ktz8866.c
+++ b/drivers/video/backlight/ktz8866.c
@@ -6,6 +6,7 @@
  */
 
 #include <linux/backlight.h>
+#include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
@@ -87,18 +88,51 @@ static int ktz8866_backlight_update_status(struct backlight_device *backlight_de
 {
 	struct ktz8866 *ktz = bl_get_data(backlight_dev);
 	unsigned int brightness = backlight_get_brightness(backlight_dev);
+	unsigned int dimming, secondary_dimming;
+	unsigned int ramp;
+	int ret;
 
-	if (!ktz->led_on && brightness > 0) {
-		ktz8866_update_bits(ktz, BL_EN, BL_EN_BIT, BL_EN_BIT);
-		ktz->led_on = true;
-	} else if (brightness == 0) {
-		ktz8866_update_bits(ktz, BL_EN, BL_EN_BIT, 0);
+	if (ktz->led_on && !brightness) {
+		ret = regmap_read(ktz->regmap, BL_DIMMING, &dimming);
+		if (ret)
+			return ret;
+		ramp = dimming & 0xf;
+		if (ktz->secondary) {
+			ret = regmap_read(ktz->secondary, BL_DIMMING,
+					  &secondary_dimming);
+			if (ret)
+				return ret;
+			ramp = max(ramp, secondary_dimming & 0xf);
+		}
+
+		ret = ktz8866_update_bits(ktz, BL_EN, BL_EN_BIT, 0);
+		if (ret)
+			return ret;
 		ktz->led_on = false;
+
+		/*
+		 * Clearing BL_EN starts the programmed fade; it does not make
+		 * the panel dark immediately. Keep the display pipeline intact
+		 * until both chips finish, before drm_panel_disable() returns.
+		 * Code 0 means 512 us, then codes 1..15 mean 1..16384 ms.
+		 */
+		fsleep(ramp ? 1000U << (ramp - 1) : 512);
 	}
 
-	/* Set brightness */
-	ktz8866_write(ktz, BL_BRT_LSB, brightness & 0x7);
-	ktz8866_write(ktz, BL_BRT_MSB, (brightness >> 3) & 0xFF);
+	/* Program the target before enabling the LED strings. */
+	ret = ktz8866_write(ktz, BL_BRT_LSB, brightness & 0x7);
+	if (ret)
+		return ret;
+	ret = ktz8866_write(ktz, BL_BRT_MSB, (brightness >> 3) & 0xFF);
+	if (ret)
+		return ret;
+
+	if (!ktz->led_on && brightness) {
+		ret = ktz8866_update_bits(ktz, BL_EN, BL_EN_BIT, BL_EN_BIT);
+		if (ret)
+			return ret;
+		ktz->led_on = true;
+	}
 
 	return 0;
 }
-- 
