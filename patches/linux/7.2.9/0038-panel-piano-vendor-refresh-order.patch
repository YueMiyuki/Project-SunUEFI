From 2bdeb196db3ea5f073f7a60a587571721ed14c79 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 04:17:01 +0800
Subject: [PATCH] drm/panel: preserve each Piano vendor refresh-command order

HyperOS 4 stock DT sends B2 then B3 on P81_35 CSOT, and B3 then B2 on P81_42 BOE. Keep the selected vendor order instead of using BOE order for both panels. Values and both vendor configurations remain unchanged.
---
 drivers/gpu/drm/panel/panel-novatek-nt36532.c | 26 +++++++++++++------
 1 file changed, 18 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36532.c b/drivers/gpu/drm/panel/panel-novatek-nt36532.c
index 1d6e86103e8..03ad59adfc8 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36532.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36532.c
@@ -508,11 +508,13 @@ static void piano_csot_vendor_sequence(struct mipi_dsi_multi_context *dsi_ctx)
 static int piano_init_sequence(struct nt36532 *ctx,
 			       const struct drm_display_mode *mode,
 			       u8 esd_cfg,
+			       bool b2_first,
 			       void (*vendor_sequence)(struct mipi_dsi_multi_context *))
 {
 	struct mipi_dsi_multi_context multi_ctx = { .dsi = to_primary_dsi(ctx) };
 	struct mipi_dsi_multi_context *dsi_ctx = &multi_ctx;
 	struct drm_dsc_picture_parameter_set pps;
+	u8 b2 = 0x91, b3 = 0x40;
 
 	/* ESD init */
 	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xff, 0x27);
@@ -623,19 +625,27 @@ static int piano_init_sequence(struct nt36532 *ctx,
 	/* Panel side refresh rate control */
 	switch (drm_mode_vrefresh(mode)) {
 	case 144:
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x00);
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x00);
+		b2 = 0x00;
+		b3 = 0x00;
 		break;
 	case 90:
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x80);
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x00);
+		b2 = 0x00;
+		b3 = 0x80;
 		break;
 	default:
 		/* 120 Hz panel timing, also used for 30/48/50/60 Hz */
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x40);
-		mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x91);
 		break;
 	}
+	/* Stock P81_35 (CSOT) sends B2 before B3; P81_42 (BOE) does the
+	 * reverse. Keep each actual panel's command order on every modeset.
+	 */
+	if (b2_first) {
+		mipi_dsi_dcs_write_var_seq_multi(dsi_ctx, 0xb2, b2);
+		mipi_dsi_dcs_write_var_seq_multi(dsi_ctx, 0xb3, b3);
+	} else {
+		mipi_dsi_dcs_write_var_seq_multi(dsi_ctx, 0xb3, b3);
+		mipi_dsi_dcs_write_var_seq_multi(dsi_ctx, 0xb2, b2);
+	}
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
 	mipi_dsi_msleep(dsi_ctx, 120);
@@ -664,13 +674,13 @@ static int piano_init_sequence(struct nt36532 *ctx,
 static int piano_boe_init_sequence(struct nt36532 *ctx,
 				   const struct drm_display_mode *mode)
 {
-	return piano_init_sequence(ctx, mode, 0x20, piano_boe_vendor_sequence);
+	return piano_init_sequence(ctx, mode, 0x20, false, piano_boe_vendor_sequence);
 }
 
 static int piano_csot_init_sequence(struct nt36532 *ctx,
 				    const struct drm_display_mode *mode)
 {
-	return piano_init_sequence(ctx, mode, 0x00, piano_csot_vendor_sequence);
+	return piano_init_sequence(ctx, mode, 0x00, true, piano_csot_vendor_sequence);
 }
 
 static int nt36532_probe(struct mipi_dsi_device *dsi)
-- 
2.56.0

