+/*
+ * MiPPS adapter authentication, ported from ianchb/xiaomi-mipps-auth
+ * 9176efbdf276b874fc0a97912a914449a88155fb. This is only the adapter
+ * challenge/response, not that project's separate fuel-gauge authentication.
+ *
+ * Run on the existing charger work item before high-voltage/direct charging.
+ * The ADSP owns PD packet transport; no userspace polling or service is needed.
+ * Voltage, thermal and current limits remain with the normal charger policy.
+ */
+static int piano_mca_vdm(struct piano_mca *mca, unsigned int cmd,
+			 const u8 *bytes, u32 flag, unsigned int settle_ms)
+{
+	__le32 payload[MCA_VDM_LEN / 4] = {};
+	unsigned long deadline;
+	size_t len = sizeof(payload[0]);
+	__le32 state;
+	int i, ret;
+
+	if (bytes) {
+		for (i = 0; i < ARRAY_SIZE(payload); i++)
+			payload[i] = cpu_to_le32(get_unaligned_be32(bytes + 4 * i));
+		len = sizeof(payload);
+	} else {
+		payload[0] = cpu_to_le32(flag);
+	}
+
+	ret = piano_mca_write(mca, MCA_PROP_VDM_BASE + cmd - 1, payload, len);
+	if (ret)
+		return ret;
+
+	msleep(settle_ms);
+	/* Stock treats these two flag commands as notifications without a reply. */
+	if (cmd == 6 || cmd == 7)
+		return 0;
+
+	deadline = jiffies + msecs_to_jiffies(2000);
+	do {
+		if (piano_mca_read_u32(mca, MCA_PROP_BUS_VOLT) < MCA_VBUS_ONLINE_UV)
+			return -ENODEV;
+		ret = piano_mca_read(mca, MCA_PROP_UVDM_STATE, &state, sizeof(state));
+		if (ret)
+			return ret;
+		if (le32_to_cpu(state) == cmd)
+			return 0;
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	return -ETIMEDOUT;
+}
+
+static void piano_mca_mipps_authenticate(struct piano_mca *mca)
+{
+	struct piano_mca_pdo pdos[MCA_PD_MAX_PDOS];
+	const struct piano_mipps_key *key;
+	u8 message[20], digest[SHA256_DIGEST_SIZE], response[MCA_VDM_LEN];
+	__le32 words[MCA_VDM_LEN / 4];
+	u32 adapter_id;
+	unsigned int key_index;
+	bool matched = false;
+	int i, ret;
+
+	if (!mipps_auth || mca->mipps_attempted || mca->auth_ok ||
+	    mca->hv != MCA_HV_OFF || mca->cp != MCA_CP_OFF ||
+	    (mca->real_type != MCA_TYPE_PD &&
+	     mca->real_type != MCA_TYPE_PD_VERIFY &&
+	     mca->real_type != MCA_TYPE_PD_PPS))
+		return;
+
+	/* Do not role-swap or send vendor commands to PCs or other PD sources. */
+	if (piano_mca_read_u32(mca, MCA_PROP_ADAPTER_SVID) != 0x2717)
+		return;
+	adapter_id = piano_mca_read_u32(mca, MCA_PROP_ADAPTER_ID);
+	if (!adapter_id ||
+	    piano_mca_read(mca, MCA_PROP_PDOS, pdos, sizeof(pdos)) ||
+	    !le32_to_cpu(pdos[1].max_mv))
+		return;
+
+	mca->mipps_attempted = true;
+	ret = piano_mca_write_u32(mca, MCA_PROP_VERIFY_PROCESS, 1);
+	if (ret)
+		goto out;
+	ret = piano_mca_write_u32(mca, MCA_PROP_PD_VERIFIED, 0);
+	if (ret)
+		goto finish;
+
+	key_index = get_random_u32_below(ARRAY_SIZE(piano_mipps_keys));
+	key = &piano_mipps_keys[key_index];
+	get_random_bytes(message, MCA_VDM_LEN);
+	put_unaligned_be32(adapter_id, message + MCA_VDM_LEN);
+	hmac_sha256_usingrawkey(key->key, sizeof(key->key),
+				message, sizeof(message), digest);
+
+	for (i = 1; i <= 3; i++) {
+		ret = piano_mca_vdm(mca, i, NULL, 0, 5);
+		if (ret)
+			goto finish;
+	}
+	ret = piano_mca_vdm(mca, 4, key->seed, 0, 500);
+	if (ret)
+		goto finish;
+	ret = piano_mca_vdm(mca, 5, message, 0, 500);
+	if (ret)
+		goto finish;
+	ret = piano_mca_read(mca, MCA_PROP_VDM_AUTH, words, sizeof(words));
+	if (ret)
+		goto finish;
+	for (i = 0; i < ARRAY_SIZE(words); i++)
+		put_unaligned_be32(le32_to_cpu(words[i]), response + 4 * i);
+	matched = !memcmp(response, digest, sizeof(response));
+	ret = piano_mca_vdm(mca, 6, NULL, matched, 100);
+	if (ret)
+		goto finish;
+	if (!matched) {
+		piano_mca_vdm(mca, 7, NULL, 0, 100);
+		ret = -EKEYREJECTED;
+		goto finish;
+	}
+	ret = piano_mca_vdm(mca, 8, digest + MCA_VDM_LEN, 0, 5);
+	if (ret)
+		goto finish;
+	ret = piano_mca_vdm(mca, 7, NULL, 1, 100);
+	if (ret)
+		goto finish;
+	if (piano_mca_read_u32(mca, MCA_PROP_ADAPTER_ID) != adapter_id ||
+	    piano_mca_read_u32(mca, MCA_PROP_BUS_VOLT) < MCA_VBUS_ONLINE_UV) {
+		ret = -ENODEV;
+		goto finish;
+	}
+	ret = piano_mca_write_u32(mca, MCA_PROP_PD_VERIFIED, 1);
+	if (!ret) {
+		mca->auth_ok = true;
+		mca->auth_at = jiffies;
+		mca->auth_tried = false;
+	}
+finish:
+	if (ret) {
+		piano_mca_write_u32(mca, MCA_PROP_PD_VERIFIED, 0);
+		piano_mca_vdm(mca, 7, NULL, 0, 100);
+	}
+	piano_mca_write_u32(mca, MCA_PROP_VERIFY_PROCESS, 0);
+	memzero_explicit(message, sizeof(message));
+	memzero_explicit(digest, sizeof(digest));
+	memzero_explicit(response, sizeof(response));
+out:
+	if (ret)
+		dev_info(mca->dev, "MiPPS authentication failed (%d); using standard PD/PPS\n", ret);
+	else
+		dev_info(mca->dev, "MiPPS adapter authenticated\n");
+	power_supply_changed(mca->usb);
+}
