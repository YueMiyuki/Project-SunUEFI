 	}
@@ -1747,6 +1912,7 @@ static const enum power_supply_property piano_mca_usb_props[] = {
 	POWER_SUPPLY_PROP_CURRENT_NOW,
 	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
 	POWER_SUPPLY_PROP_USB_TYPE,
+	POWER_SUPPLY_PROP_AUTHENTIC,
 };
 
