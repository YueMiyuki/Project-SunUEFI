From 61cd401e5cbc952dfbe1ff12e1e2fed79d4375f4 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 06:23:23 +0800
Subject: [PATCH] Bluetooth: accept LE parameter requests during feature
 discovery

A valid LE handle is already installed in BT_CONFIG. The Focus Pen Pro asks to leave its 750 ms idle interval before remote features finish; rejecting that handle delays its setup until the later retry. Preserve parameter validation and interval limits.
---
 net/bluetooth/hci_event.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/net/bluetooth/hci_event.c b/net/bluetooth/hci_event.c
index f502be73d8c..63dcc1b3f20 100644
--- a/net/bluetooth/hci_event.c
+++ b/net/bluetooth/hci_event.c
@@ -6787,7 +6787,13 @@ static void hci_le_remote_conn_param_req_evt(struct hci_dev *hdev, void *data,
 	hci_dev_lock(hdev);
 
 	hcon = hci_conn_hash_lookup_handle(hdev, handle);
-	if (!hcon || hcon->state != BT_CONNECTED) {
+	/* LE Connection Complete installs a valid controller handle before
+	 * remote feature discovery completes. A peripheral can request faster
+	 * parameters during that discovery; rejecting the existing handle
+	 * keeps slow idle intervals until its later retry.
+	 */
+	if (!hcon || hcon->type != LE_LINK ||
+	    (hcon->state != BT_CONNECTED && hcon->state != BT_CONFIG)) {
 		send_conn_param_neg_reply(hdev, handle,
 					  HCI_ERROR_UNKNOWN_CONN_ID);
 		goto unlock;
-- 
