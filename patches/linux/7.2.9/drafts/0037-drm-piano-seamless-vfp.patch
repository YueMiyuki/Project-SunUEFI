From 7afe7baa2c2589476d02bdc76c7088e8dbf0f6ba Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 03:01:01 +0800
Subject: [PATCH] drm/msm: stage Piano VFP-only mode changes at frame
 boundaries

Use the stock DSI timing DB and flush sequence, paired with DPU interface shadow timing updates. Keep panel power, DSC and touch firmware alive for modes with unchanged link clocks, horizontal timing and sync widths. Restrict initial use to the reviewed Piano video pipeline without programmable prefetch; other mode changes retain full modesets. Source reference: MiCode/vendor_opensource_display-drivers aa06fd1757c28dce96fbe4e04d4530ec21b52aac dsi_ctrl_async_timing_update and dsi_bridge_post_kickoff.

Allow ordinary atomic gamma updates alongside VFP changes. GNOME submits
color_mgmt_changed with a refresh-rate update even when routing is unchanged.
CTM enable/disable still requires a full modeset.

---
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index 59330efc662..c6b245207f9 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -754,6 +754,20 @@ void dpu_crtc_frame_event_cb(struct drm_crtc *crtc, u32 event)
  */
 void dpu_crtc_complete_commit(struct drm_crtc *crtc)
 {
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(crtc->state);
+	struct drm_encoder *encoder;
+
+	if (cstate->vfp_update) {
+		/* The normal CTL flush has completed at the new frame boundary.
+		 * Release DSI timing double buffering only after that flush.
+		 */
+		drm_for_each_encoder_mask(encoder, crtc->dev,
+					 crtc->state->encoder_mask)
+			dpu_encoder_update_vfp(encoder,
+					      &crtc->state->adjusted_mode, false);
+		drm_calc_timestamping_constants(crtc, &crtc->state->adjusted_mode);
+		cstate->vfp_update = false;
+	}
 	trace_dpu_crtc_complete_commit(DRMID(crtc));
 	dpu_core_perf_crtc_update(crtc, 0);
 	_dpu_crtc_complete_flip(crtc);
@@ -1160,6 +1174,14 @@ void dpu_crtc_commit_kickoff(struct drm_crtc *crtc)
 
 		dpu_vbif_clear_errors(dpu_kms);
 
+		if (cstate->vfp_update) {
+			drm_crtc_wait_one_vblank(crtc);
+			drm_for_each_encoder_mask(encoder, crtc->dev,
+						 crtc->state->encoder_mask)
+				dpu_encoder_update_vfp(encoder,
+						      &crtc->state->adjusted_mode, true);
+		}
+
 		drm_for_each_encoder_mask(encoder, crtc->dev,
 				crtc->state->encoder_mask) {
 			dpu_encoder_kickoff(encoder);
@@ -1210,6 +1232,7 @@ static struct drm_crtc_state *dpu_crtc_duplicate_state(struct drm_crtc *crtc)
 
 	/* duplicate base helper */
 	__drm_atomic_helper_crtc_duplicate_state(crtc, &cstate->base);
+	cstate->vfp_update = false;
 
 	return &cstate->base;
 }
@@ -1560,6 +1583,39 @@ int dpu_crtc_check_mode_changed(struct drm_crtc_state *old_crtc_state,
 	return 0;
 }
 
+static bool dpu_crtc_can_update_vfp(struct drm_crtc_state *old,
+				   struct drm_crtc_state *new)
+{
+	const struct drm_display_mode *a = &old->adjusted_mode;
+	const struct drm_display_mode *b = &new->adjusted_mode;
+	struct drm_encoder *encoder;
+
+	if (!old->active || !new->active || !new->mode_changed ||
+	    new->active_changed || new->connectors_changed ||
+	    !!old->ctm != !!new->ctm ||
+	    old->encoder_mask != new->encoder_mask ||
+	    hweight32(new->encoder_mask) != 1 || old->self_refresh_active ||
+	    new->self_refresh_active)
+		return false;
+
+	/* Same link/panel timing family; only vertical front porch may change.
+	 * 90/144 Hz have different horizontal timing and keep a full modeset.
+	 */
+	if (a->clock != b->clock || a->flags != b->flags ||
+	    a->hdisplay != b->hdisplay || a->htotal != b->htotal ||
+	    a->hsync_start != b->hsync_start || a->hsync_end != b->hsync_end ||
+	    a->hskew != b->hskew || a->vdisplay != b->vdisplay ||
+	    a->vscan != b->vscan || a->vtotal == b->vtotal ||
+	    a->vtotal - a->vsync_start != b->vtotal - b->vsync_start ||
+	    a->vtotal - a->vsync_end != b->vtotal - b->vsync_end)
+		return false;
+
+	drm_for_each_encoder_mask(encoder, new->crtc->dev, new->encoder_mask)
+		if (!dpu_encoder_can_update_vfp(encoder, b))
+			return false;
+	return true;
+}
+
 static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 		struct drm_atomic_commit *state)
 {
@@ -1643,6 +1699,11 @@ static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 		return rc;
 	}
 
+	cstate->vfp_update = dpu_crtc_can_update_vfp(
+		drm_atomic_get_old_crtc_state(state, crtc), crtc_state);
+	if (cstate->vfp_update)
+		crtc_state->mode_changed = false;
+
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
index 6eaba5696e8..084ea8ecfef 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
@@ -210,6 +210,7 @@ struct dpu_crtc_state {
 
 	bool bw_control;
 	bool bw_split_vote;
+	bool vfp_update;
 	struct drm_rect lm_bounds[CRTC_DUAL_MIXERS];
 
 	uint64_t input_fence_timeout_ns;
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index d5ea78748fc..d3c07019b1c 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -10,6 +10,7 @@
 #define pr_fmt(fmt)	"[drm:%s:%d] " fmt, __func__, __LINE__
 #include <linux/debugfs.h>
 #include <linux/kthread.h>
+#include <linux/of.h>
 #include <linux/seq_file.h>
 
 #include <drm/display/drm_dsc_helper.h>
@@ -716,6 +717,58 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 	}
 }
 
+bool dpu_encoder_can_update_vfp(struct drm_encoder *encoder,
+			       const struct drm_display_mode *mode)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	unsigned int i;
+
+	/* Both Piano panel variants advertise stock immediate-VFP updates.
+	 * Do not infer this panel capability from the SoC alone.
+	 */
+	if (!of_machine_is_compatible("xiaomi,piano") ||
+	    enc->disp_info.intf_type != INTF_DSI || enc->disp_info.is_cmd_mode ||
+	    !enc->num_phys_encs)
+		return false;
+
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		if (!phys->hw_intf || !phys->hw_intf->ops.update_vtotal ||
+		    !phys->hw_ctl || !phys->hw_ctl->ops.update_pending_flush_intf)
+			return false;
+		/* Keep prefetch disabled, as on Piano's stock 120 Hz family.
+		 * Supporting a changing prefetch offset needs its own update.
+		 */
+		if (mode->vtotal - mode->vsync_start <
+		    phys->hw_intf->cap->prog_fetch_lines_worst_case)
+			return false;
+	}
+	return true;
+}
+
+void dpu_encoder_update_vfp(struct drm_encoder *encoder,
+			   const struct drm_display_mode *mode, bool stage)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	struct msm_drm_private *priv = encoder->dev->dev_private;
+	unsigned int index = enc->disp_info.h_tile_instance[0];
+	unsigned int i;
+
+	msm_dsi_update_vfp(priv->kms->dsi[index], mode, stage);
+	if (!stage)
+		return;
+
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		phys->cached_mode = *mode;
+		phys->hw_intf->ops.update_vtotal(phys->hw_intf, mode->vtotal);
+		phys->hw_ctl->ops.update_pending_flush_intf(phys->hw_ctl,
+							  phys->hw_intf->idx);
+	}
+}
+
 bool dpu_encoder_needs_modeset(struct drm_encoder *drm_enc, struct drm_atomic_commit *state)
 {
 	struct drm_connector *connector;
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
index 4942097e761..ef884b0bb81 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h
@@ -21,6 +21,11 @@
 
 #define MAX_H_TILES_PER_DISPLAY 2
 
+bool dpu_encoder_can_update_vfp(struct drm_encoder *encoder,
+			       const struct drm_display_mode *mode);
+void dpu_encoder_update_vfp(struct drm_encoder *encoder,
+			   const struct drm_display_mode *mode, bool stage);
+
 /**
  * struct msm_display_info - defines display properties
  * @intf_type:          INTF_ type
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
index ac82b69aedf..d26348609e9 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
@@ -272,6 +272,16 @@ static void dpu_hw_intf_setup_timing_engine(struct dpu_hw_intf *intf,
 	}
 }
 
+static void dpu_hw_intf_update_vtotal(struct dpu_hw_intf *intf, u32 vtotal)
+{
+	u32 htotal = DPU_REG_READ(&intf->hw, INTF_HSYNC_CTL) >> 16;
+
+	/* Active start/end stay fixed for a VFP-only update. The regular
+	 * CTL interface flush commits this shadow register at a frame boundary.
+	 */
+	DPU_REG_WRITE(&intf->hw, INTF_VSYNC_PERIOD_F0, vtotal * htotal);
+}
+
 static void dpu_hw_intf_enable_timing_engine(
 		struct dpu_hw_intf *intf,
 		u8 enable)
@@ -637,6 +647,8 @@ struct dpu_hw_intf *dpu_hw_intf_init(struct drm_device *dev,
 	c->mdss_ver = mdss_rev;
 
 	c->ops.setup_timing_gen = dpu_hw_intf_setup_timing_engine;
+	if (mdss_rev->core_major_ver == 12 && cfg->type == INTF_DSI)
+		c->ops.update_vtotal = dpu_hw_intf_update_vtotal;
 	c->ops.setup_prg_fetch  = dpu_hw_intf_setup_prg_fetch;
 	c->ops.get_status = dpu_hw_intf_get_status;
 	c->ops.enable_timing = dpu_hw_intf_enable_timing_engine;
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
index badd26305fc..039c114bc06 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
@@ -78,6 +78,7 @@ struct dpu_hw_intf_cmd_mode_cfg {
  * @program_intf_cmd_cfg:       Program the DPU to interface datapath for command mode
  */
 struct dpu_hw_intf_ops {
+	void (*update_vtotal)(struct dpu_hw_intf *intf, u32 vtotal);
 	void (*setup_timing_gen)(struct dpu_hw_intf *intf,
 			const struct dpu_hw_intf_timing_params *p,
 			const struct msm_format *fmt);
diff --git a/drivers/gpu/drm/msm/dsi/dsi.h b/drivers/gpu/drm/msm/dsi/dsi.h
index 152dccc2240..9ce5252e37f 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -70,6 +70,8 @@ void msm_dsi_host_cmd_xfer_commit(struct mipi_dsi_host *host,
 					u32 dma_base, u32 len);
 int msm_dsi_host_enable(struct mipi_dsi_host *host);
 int msm_dsi_host_enable_video(struct mipi_dsi_host *host);
+void msm_dsi_host_update_vfp(struct mipi_dsi_host *host,
+			    const struct drm_display_mode *mode, bool stage);
 int msm_dsi_host_disable_video(struct mipi_dsi_host *host);
 int msm_dsi_host_disable(struct mipi_dsi_host *host);
 void msm_dsi_host_enable_irq(struct mipi_dsi_host *host);
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 7922d56b92c..a3d0e7795b8 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -2690,6 +2690,30 @@ int msm_dsi_host_power_off(struct mipi_dsi_host *host)
 	return 0;
 }
 
+/*
+ * SM8750 video timing shadow registers, as used by the downstream
+ * dsi_ctrl_async_timing_update()/dsi_ctrl_timing_db_update() sequence.
+ * Only VFP changes are accepted by the DPU atomic check: horizontal timing,
+ * DSC, active area, sync widths and link clocks stay unchanged.
+ */
+void msm_dsi_host_update_vfp(struct mipi_dsi_host *host,
+			    const struct drm_display_mode *mode, bool stage)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 total;
+
+	if (stage) {
+		dsi_write(msm_host, 0x1e8, 1); /* DSI_TIMING_DB_MODE */
+		total = dsi_read(msm_host, REG_DSI_TOTAL);
+		total = (total & 0xffff) | DSI_TOTAL_V_TOTAL(mode->vtotal - 1);
+		dsi_write(msm_host, REG_DSI_TOTAL, total);
+		dsi_write(msm_host, 0x1e4, 1); /* DSI_TIMING_FLUSH */
+		drm_mode_copy(msm_host->mode, mode);
+	} else {
+		dsi_write(msm_host, 0x1e8, 0);
+	}
+}
+
 int msm_dsi_host_set_display_mode(struct mipi_dsi_host *host,
 				  const struct drm_display_mode *mode)
 {
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index fb18beb7002..68fba3c8708 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -46,6 +46,21 @@ static inline struct msm_dsi *dsi_mgr_get_other_dsi(int id)
 	return msm_dsim_glb.dsi[(id + 1) % DSI_MAX];
 }
 
+void msm_dsi_update_vfp(struct msm_dsi *dsi,
+			const struct drm_display_mode *mode, bool stage)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+
+	/* The stock split-DSI sequence updates the clock master first. */
+	if (IS_BONDED_DSI()) {
+		msm_dsi_host_update_vfp(master->host, mode, stage);
+		msm_dsi_host_update_vfp(slave->host, mode, stage);
+	} else {
+		msm_dsi_host_update_vfp(dsi->host, mode, stage);
+	}
+}
+
 static int dsi_mgr_parse_of(struct device_node *np, int id)
 {
 	struct msm_dsi_manager *msm_dsim = &msm_dsim_glb;
diff --git a/drivers/gpu/drm/msm/msm_drv.h b/drivers/gpu/drm/msm/msm_drv.h
index 3d5679be488..6b45a13aabd 100644
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -303,6 +303,8 @@ bool msm_dsi_is_cmd_mode(struct msm_dsi *msm_dsi);
 bool msm_dsi_is_bonded_dsi(struct msm_dsi *msm_dsi);
 bool msm_dsi_is_master_dsi(struct msm_dsi *msm_dsi);
 bool msm_dsi_wide_bus_enabled(struct msm_dsi *msm_dsi);
+void msm_dsi_update_vfp(struct msm_dsi *dsi,
+			const struct drm_display_mode *mode, bool stage);
 struct drm_dsc_config *msm_dsi_get_dsc_config(struct msm_dsi *msm_dsi);
 const char *msm_dsi_get_te_source(struct msm_dsi *msm_dsi);
 #else
@@ -338,6 +340,11 @@ static inline bool msm_dsi_wide_bus_enabled(struct msm_dsi *msm_dsi)
 	return false;
 }
 
+static inline void msm_dsi_update_vfp(struct msm_dsi *dsi,
+				     const struct drm_display_mode *mode, bool stage)
+{
+}
+
 static inline struct drm_dsc_config *msm_dsi_get_dsc_config(struct msm_dsi *msm_dsi)
 {
 	return NULL;
