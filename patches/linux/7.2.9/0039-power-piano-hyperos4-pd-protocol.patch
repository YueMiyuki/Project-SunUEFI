From 3fe3e997a83da3803f74596cea4cadec0edc2114 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 04:38:25 +0800
Subject: [PATCH] power: piano: translate HyperOS 4 MCA PD properties

The stock OS4.0.2.1 vendor PD module adds a property at 0x2100b. Its source PDO query is 0x21012, PPS selection 0x21018 and fixed voltage request 0x21019. Keep logical property IDs and the write allowlist stable, translating at the transport boundary according to the DT firmware ABI version. Legacy ADSP remains version 1.
---
 .../bindings/soc/qcom/qcom,pmic-glink.yaml      | 10 ++++++++++
 drivers/power/supply/piano_mca.c                | 17 +++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
index 2db4288a8a5..4e8728c98b9 100644
--- a/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,pmic-glink.yaml
@@ -55,6 +55,16 @@ properties:
   '#address-cells':
     const: 1
 
+  xiaomi,mca-pd-protocol-version:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [1, 2]
+    default: 1
+    description: |
+      Property numbering of the Xiaomi MCA PD service in the loaded ADSP
+      firmware. Version 1 is used by Piano HyperOS 3. HyperOS 4 uses version
+      2, inserting one property before the data-role and source-PDO controls.
+      This must match the ADSP firmware shipped with the operating system.
+
   '#size-cells':
     const: 0
 
diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index caf00f23326..7f7a15d3ed6 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -37,6 +37,7 @@
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/power_supply.h>
+#include <linux/property.h>
 #include <linux/seq_file.h>
 #include <linux/unaligned.h>
 #include <linux/workqueue.h>
@@ -432,6 +433,7 @@ struct mca_resp {
 
 struct piano_mca {
 	struct device *dev;
+	u32 pd_protocol_version;
 	struct pmic_glink_client *client;
 	struct mutex lock;
 	struct completion ack;
@@ -667,6 +669,15 @@ static int piano_mca_xfer(struct piano_mca *mca, u32 opcode, u32 prop,
 
 	if (len > MCA_DATA_LEN)
 		return -EINVAL;
+	/*
+	 * HyperOS 4 inserts a PD property at 0x2100b. The subsequent
+	 * data-role, source-PDO, PPS-select and fixed-voltage properties all
+	 * move by one. Keep our semantic IDs and write allowlist stable;
+	 * translate once at the transport boundary for the selected firmware.
+	 * Confirmed against both stock qcom_adsp_pd_protocol.ko versions.
+	 */
+	if (mca->pd_protocol_version == 2 && prop >= 0x2100b && prop <= 0x21026)
+		req.property = cpu_to_le32(prop + 1);
 	if (opcode == MCA_OP_WRITE)
 		memcpy(req.data, buf, len);
 
@@ -2226,6 +2237,12 @@ static int piano_mca_probe(struct auxiliary_device *adev,
 		return -ENOMEM;
 
 	mca->dev = dev;
+	mca->pd_protocol_version = 1;
+	device_property_read_u32(dev, "xiaomi,mca-pd-protocol-version",
+				 &mca->pd_protocol_version);
+	if (mca->pd_protocol_version < 1 || mca->pd_protocol_version > 2)
+		return dev_err_probe(dev, -EINVAL, "unsupported MCA PD protocol\n");
+	dev_info(dev, "MCA PD protocol version %u\n", mca->pd_protocol_version);
 	mca->hv_retry = jiffies;
 	mutex_init(&mca->lock);
 	init_completion(&mca->ack);
-- 
2.56.0

