From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] Filter common row and column interference before touch peaks

A live 40x60 Piano capture showed four 3-column bands spanning every row,
with delta 500..580 against the 200 touch threshold. These generated phantom
multitouch sequences despite sub-millisecond input delivery. Estimate the
common line component with medians before detecting local finger peaks,
without raising the touch threshold or changing the separate pen decoder.

OEM reference: piano_nova_boe_thp_config.ini, threshold1.filter_line_gap
and base_trace. The median filter is a project implementation.

---
--- a/initramfs/touch-view/piano-touch-view.c
+++ b/initramfs/touch-view/piano-touch-view.c
@@ -197,6 +197,47 @@
 		ref_count, ref_type, st.rows, st.cols);
 }
 
+/* Reject line-wide capacitive interference before looking for local peaks.
+ * A finger occupies a small part of a row/column; the median estimates the
+ * common component without learning the finger into the baseline. The Piano
+ * failure capture contains four three-column bands across all 40 sensor rows.
+ * Stock THP also has separate line-noise and baseline stages; this is our
+ * implementation, not a claim to reproduce its proprietary algorithm.
+ */
+static int cmp_delta(const void *a, const void *b)
+{
+	int left = *(const int *)a, right = *(const int *)b;
+
+	return (left > right) - (left < right);
+}
+
+static void remove_line_noise(void)
+{
+	/* Matrix dimensions are one-byte fields in the validated THP payload. */
+	int line[256], r, c, common;
+
+	for (c = 0; c < st.cols; c++) {
+		for (r = 0; r < st.rows; r++)
+			line[r] = delta[r * st.cols + c];
+		qsort(line, st.rows, sizeof(line[0]), cmp_delta);
+		common = line[st.rows / 2];
+		for (r = 0; r < st.rows; r++)
+			delta[r * st.cols + c] -= common;
+	}
+	for (r = 0; r < st.rows; r++) {
+		for (c = 0; c < st.cols; c++)
+			line[c] = delta[r * st.cols + c];
+		qsort(line, st.cols, sizeof(line[0]), cmp_delta);
+		common = line[st.cols / 2];
+		for (c = 0; c < st.cols; c++)
+			delta[r * st.cols + c] -= common;
+	}
+	st.max_delta = 0;
+	for (r = 0; r < st.rows * st.cols; r++)
+		if (delta[r] > st.max_delta)
+			st.max_delta = delta[r];
+}
+
 static void print_map(void)
 {
 	static const char ramp[] = " .:-=+*#%@";
@@ -659,9 +700,8 @@
 		int d = (int16_t)le16(p + 64 + n * 2) - reference[n];
 
 		delta[n] = opt.invert ? -d : d;
-		if (delta[n] > st.max_delta)
-			st.max_delta = delta[n];
-	}
+	}
+	remove_line_noise();
 	/* follow slow baseline drift while nothing is near the threshold */
 	if (st.max_delta < opt.threshold / 2)
 		for (n = 0; n < (int)nodes; n++)
