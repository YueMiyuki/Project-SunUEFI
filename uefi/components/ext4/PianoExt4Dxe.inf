[Defines]
  INF_VERSION = 0x00010005
  BASE_NAME = PianoExt4Dxe
  FILE_GUID = 4127BD76-A19F-45C4-858A-45585434494F
  MODULE_TYPE = DXE_DRIVER
  ENTRY_POINT = PianoExt4Entry
[Sources]
  PianoExt4.c
  PianoExt4Compat.c
  # LWEXT4_SOURCES
[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  DebugLib
  DevicePathLib
  PrintLib
[Guids]
  gEfiFileInfoGuid
  gEfiFileSystemInfoGuid
  gEfiFileSystemVolumeLabelInfoIdGuid
  gEfiEventExitBootServicesGuid
[Protocols]
  gEfiBlockIoProtocolGuid
  gEfiDiskIoProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiPartitionInfoProtocolGuid
  gEfiDevicePathProtocolGuid
[BuildOptions]
  GCC:*_CLANGPDB_AARCH64_CC_FLAGS = -I$(MODULE_DIR)/compat -I$(MODULE_DIR)/lwext4/include -DCONFIG_USE_DEFAULT_CFG=1 -DCONFIG_HAVE_OWN_ERRNO=1 -DCONFIG_DEBUG_PRINTF=0 -DCONFIG_DEBUG_ASSERT=0 -DCONFIG_BLOCK_DEV_CACHE_SIZE=16 -DCONFIG_UNALIGNED_ACCESS=1 -Wno-error -Wno-unused-function
[Depex]
  TRUE
