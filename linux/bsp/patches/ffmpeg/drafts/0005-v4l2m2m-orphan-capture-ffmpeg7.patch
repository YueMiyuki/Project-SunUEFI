+void ff_v4l2_buffer_pool_unref(V4L2BufferPool *pool)
+{
+    unsigned int i, j;
+
+    if (!pool || atomic_fetch_sub_explicit(&pool->refs, 1, memory_order_acq_rel) != 1)
+        return;
+    for (i = 0; i < pool->count; i++) {
+        V4L2Buffer *buffer = &pool->buffers[i];
+        for (j = 0; j < buffer->num_planes; j++) {
+            struct V4L2Plane_info *p = &buffer->plane_info[j];
+            if (p->mm_addr && p->mm_addr != MAP_FAILED && p->length)
+                munmap(p->mm_addr, p->length);
+        }
+    }
+    pthread_mutex_destroy(&pool->lock);
+    av_free(pool);
+}
+
+int ff_v4l2_context_orphan_buffers(V4L2Context *ctx)
+{
+    V4L2BufferPool *pool = ctx->pool;
+    struct v4l2_requestbuffers req = {
+        .memory = V4L2_MEMORY_MMAP,
+        .type = ctx->type,
+        .count = 0,
+    };
+    int ret;
+
+    if (!pool || !(ctx->buffer_capabilities & V4L2_BUF_CAP_SUPPORTS_ORPHANED_BUFS))
+        return AVERROR(ENOSYS);
+    /* Serialize retiring the queue against the last AVBufferRef's QBUF.
+     * The kernel advertises that old mmaps may outlive REQBUFS(0).
+     */
+    pthread_mutex_lock(&pool->lock);
+    pool->retired = 1;
+    ret = ff_v4l2_context_set_status(ctx, VIDIOC_STREAMOFF);
+    if (!ret && ioctl(ctx_to_m2mctx(ctx)->fd, VIDIOC_REQBUFS, &req) < 0)
+        ret = AVERROR(errno);
+    pthread_mutex_unlock(&pool->lock);
+    if (ret)
+        return ret;
+    ctx->pool = NULL;
+    ctx->buffers = NULL;
+    ff_v4l2_buffer_pool_unref(pool);
+    return 0;
+}
+
 static int v4l2_release_buffers(V4L2Context* ctx)
 {
     struct v4l2_requestbuffers req = {
