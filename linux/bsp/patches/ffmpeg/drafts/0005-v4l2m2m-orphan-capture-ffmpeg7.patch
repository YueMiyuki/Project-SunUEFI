From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] avcodec/v4l2m2m: retain old capture mappings across resolution changes

Use V4L2 orphaned buffers where advertised, keeping old mappings until the
last AVBufferRef is released. Stop old-generation QBUF at DRC LAST and
resume available buffers only after the decoder resumes.

Device validation of DRC is pending the companion Iris PSC_LAST fix.

--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -217,20 +217,25 @@
 
     if (atomic_fetch_sub(&avbuf->context_refcount, 1) == 1) {
         const V4L2m2mContext *context_ref = avbuf->context_ref;
-
+        V4L2BufferPool *pool = avbuf->pool;
+
+        pthread_mutex_lock(&pool->lock);
         avbuf->context_ref = NULL;
-        if (!s->reinit) {
+        if (!pool->retired && !s->reinit) {
             if (s->draining && V4L2_TYPE_IS_OUTPUT(avbuf->context->type)) {
                 /* no need to queue more buffers to the driver */
                 avbuf->status = V4L2BUF_AVAILABLE;
             }
             else if (avbuf->context->streamon)
                 ff_v4l2_buffer_enqueue(avbuf);
-        }
-
-        /* Reinit may free the buffer array as soon as this count reaches zero. */
+        } else
+            avbuf->status = V4L2BUF_AVAILABLE;
+        pthread_mutex_unlock(&pool->lock);
+
+        /* Finish every buffer access before allowing capture remapping. */
         if (atomic_fetch_sub_explicit(&s->refcount, 1, memory_order_acq_rel) == 1 && s->reinit)
             sem_post(&s->refsync);
+        ff_v4l2_buffer_pool_unref(pool);
         ff_refstruct_unref(&context_ref);
     }
 }
@@ -245,6 +250,7 @@
         in->context_ref = ff_refstruct_ref(s->self_ref);
 
         in->context_refcount = 1;
+        atomic_fetch_add_explicit(&in->pool->refs, 1, memory_order_relaxed);
         atomic_fetch_add_explicit(&s->refcount, 1, memory_order_relaxed);
     }
 
