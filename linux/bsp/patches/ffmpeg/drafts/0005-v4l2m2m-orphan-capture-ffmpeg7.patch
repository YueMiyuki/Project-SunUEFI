+
+/* One queue allocation. The context owns one reference; each buffer handed
+ * to a caller owns another until all its per-plane AVBufferRefs are gone.
+ */
+typedef struct V4L2BufferPool {
+    atomic_uint refs;
+    pthread_mutex_t lock;
+    int retired;
+    unsigned int count;
+    V4L2Buffer buffers[];
+} V4L2BufferPool;
+
+void ff_v4l2_buffer_pool_unref(V4L2BufferPool *pool);
 
