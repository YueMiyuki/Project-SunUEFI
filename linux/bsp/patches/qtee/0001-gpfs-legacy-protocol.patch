From 418e6990cdce1f6abecfca656c0db226fda91d0a Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Thu, 22 Oct 2026 13:52:25 +0800
Subject: [PATCH] libfsservice: handle legacy absolute-path GPFS requests

Piano HyperOS 4 signed applications still issue command IDs 0 through 3. Reuse the existing legacy path resolver and the same packed read/write/remove/rename messages alongside the explicit data/persist variants. Stop the read loop at EOF instead of waiting forever without forward progress. The vendor dispatch confirms IDs and field offsets; real QTEE callbacks completed reads, writes and removals in Linux-owned storage.
---
 listeners/libfsservice/gpfs/gpfs.c      | 44 +++++++++++++++++++++++--
 listeners/libfsservice/gpfs/gpfs_main.c |  4 +++
 listeners/libfsservice/gpfs/gpfs_msg.h  |  4 +++
 3 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/listeners/libfsservice/gpfs/gpfs.c b/listeners/libfsservice/gpfs/gpfs.c
index e7c5a32..41ddfe0 100644
--- a/listeners/libfsservice/gpfs/gpfs.c
+++ b/listeners/libfsservice/gpfs/gpfs.c
@@ -413,13 +413,15 @@ static int perform_read_write(uint32_t cmd_id, int fd, uint8_t *buf,
 	int ret_val = 0;
 
 	while (bytes_remaining > 0) {
-		if (cmd_id == TZ_GPFS_MSG_CMD_DATA_FILE_READ ||
+		if (cmd_id == TZ_GPFS_MSG_CMD_FILE_READ ||
+		    cmd_id == TZ_GPFS_MSG_CMD_DATA_FILE_READ ||
 		    cmd_id == TZ_GPFS_MSG_CMD_PERSIST_FILE_READ) {
 			ret_val = read(fd, buf, bytes_remaining);
 			if (ret_val < 0)
 				return errno;
 			MSGD("Read %d bytes\n", ret_val);
-		} else if (cmd_id == TZ_GPFS_MSG_CMD_DATA_FILE_WRITE ||
+		} else if (cmd_id == TZ_GPFS_MSG_CMD_FILE_WRITE ||
+			   cmd_id == TZ_GPFS_MSG_CMD_DATA_FILE_WRITE ||
 			   cmd_id == TZ_GPFS_MSG_CMD_PERSIST_FILE_WRITE) {
 			ret_val = write(fd, buf, bytes_remaining);
 			if (ret_val < 0)
@@ -430,6 +432,9 @@ static int perform_read_write(uint32_t cmd_id, int fd, uint8_t *buf,
 			return EINVAL;
 		}
 
+		if (!ret_val)
+			break; /* EOF / no forward progress. */
+
 		buf += ret_val;
 		bytes_remaining -= ret_val;
 	}
@@ -542,6 +547,14 @@ int gpfile_read(void *req, size_t req_len, void *rsp, size_t rsp_len)
 	}
 
 	switch (my_req->cmd_id) {
+	case TZ_GPFS_MSG_CMD_FILE_READ: {
+		char *resolved = get_resolved_path(my_req->pathname,
+				strlen(my_req->pathname), abs_file_path,
+				sizeof(abs_file_path));
+		if (resolved != abs_file_path)
+			strlcpy(abs_file_path, resolved, sizeof(abs_file_path));
+		break;
+	}
 	case TZ_GPFS_MSG_CMD_PERSIST_FILE_READ:
 		strlcpy(abs_file_path, PERSIST_PATH, TZ_FILE_NAME_LEN);
 		strlcat(abs_file_path, my_req->pathname,
@@ -606,6 +619,14 @@ int gpfile_write(void *req, size_t req_len, void *rsp, size_t rsp_len)
 	}
 
 	switch (my_req->cmd_id) {
+	case TZ_GPFS_MSG_CMD_FILE_WRITE: {
+		char *resolved = get_resolved_path(my_req->pathname,
+				strlen(my_req->pathname), abs_file_path,
+				sizeof(abs_file_path));
+		if (resolved != abs_file_path)
+			strlcpy(abs_file_path, resolved, sizeof(abs_file_path));
+		break;
+	}
 	case TZ_GPFS_MSG_CMD_PERSIST_FILE_WRITE:
 		strlcpy(abs_file_path, PERSIST_PATH, TZ_FILE_NAME_LEN);
 		strlcat(abs_file_path, my_req->pathname,
@@ -667,6 +688,14 @@ int gpfile_remove(void *req, size_t req_len, void *rsp, size_t rsp_len)
 	}
 
 	switch (my_req->cmd_id) {
+	case TZ_GPFS_MSG_CMD_FILE_REMOVE: {
+		char *resolved = get_resolved_path(my_req->pathname,
+				strlen(my_req->pathname), abs_file_path,
+				sizeof(abs_file_path));
+		if (resolved != abs_file_path)
+			strlcpy(abs_file_path, resolved, sizeof(abs_file_path));
+		break;
+	}
 	case TZ_GPFS_MSG_CMD_PERSIST_FILE_REMOVE:
 		strlcpy(abs_file_path, PERSIST_PATH, TZ_FILE_NAME_LEN);
 		strlcat(abs_file_path, my_req->pathname,
@@ -743,6 +772,17 @@ int gpfile_rename(void *req, size_t req_len, void *rsp, size_t rsp_len)
 	}
 
 	switch (my_req->cmd_id) {
+	case TZ_GPFS_MSG_CMD_FILE_RENAME: {
+		char *old_path = get_resolved_path(my_req->from, strlen(my_req->from),
+				abs_file_path_old, sizeof(abs_file_path_old));
+		char *new_path = get_resolved_path(my_req->to, strlen(my_req->to),
+				abs_file_path_new, sizeof(abs_file_path_new));
+		if (old_path != abs_file_path_old)
+			strlcpy(abs_file_path_old, old_path, sizeof(abs_file_path_old));
+		if (new_path != abs_file_path_new)
+			strlcpy(abs_file_path_new, new_path, sizeof(abs_file_path_new));
+		break;
+	}
 	case TZ_GPFS_MSG_CMD_PERSIST_FILE_RENAME:
 		strlcpy(abs_file_path_old, PERSIST_PATH, TZ_FILE_NAME_LEN);
 		strlcat(abs_file_path_old, my_req->from,
diff --git a/listeners/libfsservice/gpfs/gpfs_main.c b/listeners/libfsservice/gpfs/gpfs_main.c
index 2f64e81..c8d2b9b 100644
--- a/listeners/libfsservice/gpfs/gpfs_main.c
+++ b/listeners/libfsservice/gpfs/gpfs_main.c
@@ -145,24 +145,28 @@ int smci_dispatch(void *buf, size_t buf_len)
 
 	/* Read command id */
 	switch (gpfs_cmd_id) {
+	case (TZ_GPFS_MSG_CMD_FILE_READ):
 	case (TZ_GPFS_MSG_CMD_DATA_FILE_READ):
 	case (TZ_GPFS_MSG_CMD_PERSIST_FILE_READ):
 		MSGD("gpfile_read starts!\n");
 		ret = gpfile_read(buf, buf_len, buf, buf_len);
 		MSGD("gpfile_read finished!\n");
 		break;
+	case (TZ_GPFS_MSG_CMD_FILE_WRITE):
 	case (TZ_GPFS_MSG_CMD_DATA_FILE_WRITE):
 	case (TZ_GPFS_MSG_CMD_PERSIST_FILE_WRITE):
 		MSGD("gpfile_write starts!\n");
 		ret = gpfile_write(buf, buf_len, buf, buf_len);
 		MSGD("gpfile_write finished!\n");
 		break;
+	case (TZ_GPFS_MSG_CMD_FILE_REMOVE):
 	case (TZ_GPFS_MSG_CMD_DATA_FILE_REMOVE):
 	case (TZ_GPFS_MSG_CMD_PERSIST_FILE_REMOVE):
 		MSGD("gpfile_remove starts!\n");
 		ret = gpfile_remove(buf, buf_len, buf, buf_len);
 		MSGD("gpfile_remove finished!\n");
 		break;
+	case (TZ_GPFS_MSG_CMD_FILE_RENAME):
 	case (TZ_GPFS_MSG_CMD_DATA_FILE_RENAME):
 	case (TZ_GPFS_MSG_CMD_PERSIST_FILE_RENAME):
 		MSGD("gpfile_rename starts!\n");
diff --git a/listeners/libfsservice/gpfs/gpfs_msg.h b/listeners/libfsservice/gpfs/gpfs_msg.h
index c62568e..2196bc3 100644
--- a/listeners/libfsservice/gpfs/gpfs_msg.h
+++ b/listeners/libfsservice/gpfs/gpfs_msg.h
@@ -19,6 +19,10 @@
  * from the Rich Execution Environment (REE).
  */
 typedef enum {
+	TZ_GPFS_MSG_CMD_FILE_READ = 0, /* Legacy absolute-path protocol. */
+	TZ_GPFS_MSG_CMD_FILE_WRITE,
+	TZ_GPFS_MSG_CMD_FILE_REMOVE,
+	TZ_GPFS_MSG_CMD_FILE_RENAME,
 	TZ_GPFS_MSG_CMD_DATA_FILE_READ = 0x00000004, /**< Read from a file in data partition */
 	TZ_GPFS_MSG_CMD_DATA_FILE_WRITE, /**< Write to a file in data partition */
 	TZ_GPFS_MSG_CMD_DATA_FILE_REMOVE, /**< Remove a file from data partition */
-- 
2.56.0

