# Build against SteamOS's own libraries. Keep Valve's package identity so
# dependent native packages and the separate FEX guest runtime remain intact.
pkgname=deckard-mesa-linux-aarch64
pkgver=26.2.4
pkgrel=1.1
pkgdesc='Native SteamOS Mesa with Piano Adreno 830v1 support'
arch=(aarch64)
url='https://www.mesa3d.org/'
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
provides=(mesa mesa-libgl opengl-driver vulkan-driver)
conflicts=(mesa mesa-libgl deckard-mesa-linux-aarch64-assert)
depends=(libdrm wayland libxshmfence libelf libdisplay-info libglvnd zstd
         vulkan-icd-loader expat gcc-libs libx11 libxcb libxext libxxf86vm)
makedepends=(base-devel meson python-mako python-packaging python-ply python-yaml
             glslang spirv-tools wayland-protocols xorgproto xcb-util-keysyms)
options=(!lto !debug)
source=("https://archive.mesa3d.org/mesa-$pkgver.tar.xz"
        '0001-freedreno-Add-chip-id-support-for-A830v1.patch')
b2sums=('28506a9366e3c031acbb52924e43b0ec098f44a3ac3bb839ec2a86fa0faf83652347704b0e58bdc447aaebae5a2a254e5456e0b893755fd7721e57d6b614ecc4'
        'e675b526263b6e961870aec23b2f9ba0e69bdc4a52dd7503aae61a762427de7103198567c2a8c35386357855bee6f1c61dfda0500692960363363abb0decb193')

prepare() {
  cd "mesa-$pkgver"
  patch --forward --fuzz=0 -Np1 < ../0001-freedreno-Add-chip-id-support-for-A830v1.patch
  echo "$pkgver-sunuefi$pkgrel" > VERSION
}

build() {
  arch-meson "mesa-$pkgver" build \
    -Dgallium-drivers=freedreno,zink -Dvulkan-drivers=freedreno \
    -Dfreedreno-kmds=msm,virtio -Dplatforms=x11,wayland \
    -Dglvnd=enabled -Dgles1=disabled -Dgles2=enabled \
    -Dllvm=disabled -Dgallium-va=disabled -Dgallium-rusticl=false \
    -Dgallium-mediafoundation=disabled -Dbuild-tests=false -Dhtml-docs=disabled \
    -Dandroid-libbacktrace=disabled -Dmicrosoft-clc=disabled \
    -Dintel-rt=disabled -Dlibunwind=disabled -Dvalgrind=disabled \
    -Dvulkan-layers= -Dvulkan-manifest-per-architecture=true
  meson compile -C build -j6
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
  install -Dm644 "mesa-$pkgver/docs/license.rst" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
