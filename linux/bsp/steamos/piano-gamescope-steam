#!/bin/sh
set -eu
export GAMESCOPE_WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-gamescope-0}"
export QT_QPA_PLATFORM=xcb
export STEAM_ENABLE_VOLUME_HANDLER=1
unset WAYLAND_DISPLAY XDG_SESSION_TYPE
dbus-update-activation-environment --systemd \
    DISPLAY GAMESCOPE_WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_RUNTIME_DIR SteamDeck
systemd-notify --ready
exec steam -steamdeck -steamos3 -gamepadui
