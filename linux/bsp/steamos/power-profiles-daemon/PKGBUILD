pkgname=power-profiles-daemon
pkgver=0.30
pkgrel=1.1
pkgdesc='Standard desktop power profile service'
arch=(aarch64)
url='https://gitlab.freedesktop.org/upower/power-profiles-daemon'
license=(GPL-3.0-or-later)
depends=(glib2 libgudev upower polkit python python-gobject)
makedepends=(base-devel meson ninja pkgconf)
options=(!lto !debug)
_commit=1a151ccd8bb42c050960f65ca3dee31effde6b36
source=("$url/-/archive/$_commit/power-profiles-daemon-$_commit.tar.gz")
sha256sums=('a0c3514a84f43df2b6b331d11ec2497fe83e2e9db666a7ff1336cfefae63020d')

build() {
  meson setup "power-profiles-daemon-$_commit" build \
    --prefix=/usr --libexecdir=lib --buildtype=release \
    -Dtests=false -Dgtk_doc=false -Dmanpage=disabled \
    -Dbashcomp=disabled -Dpylint=disabled
  meson compile -C build -j6
}

package() {
  DESTDIR="$pkgdir" meson install -C build
}
