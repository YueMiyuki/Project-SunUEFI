# Notify the DSPs over SMP2P before the AP enters system sleep; without it the
# ADSP watchdog fires right after resume on firmware that publishes the entry.
CONFIG_QCOM_SMP2P_SLEEPSTATE=y
# The factory PMIC RTC is an uptime counter with Android's separate epoch
# offset. Use it for wake alarms without replacing Linux wall time.
CONFIG_RTC_HCTOSYS=n
CONFIG_RTC_SYSTOHC=n
