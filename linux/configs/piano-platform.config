# Qualcomm SCMI uses the standard performance/clock protocols.
# NXP vendor protocols must not attach to Qualcomm protocol 0x80.
CONFIG_IMX_SCMI_LMM_DRV=n
CONFIG_IMX_SCMI_CPU_DRV=n
CONFIG_IMX_SCMI_MISC_DRV=n
CONFIG_IMX_SCMI_LMM_EXT=n
CONFIG_IMX_SCMI_CPU_EXT=n
CONFIG_IMX_SCMI_MISC_EXT=n
CONFIG_IMX_SCMI_BBM_EXT=n

# Gunyah owns EL2 on the stock boot chain. Build the VM manager in, retaining
# direct-map invalidation for lent pages (unavailable to loadable modules).
CONFIG_GUNYAH=y
CONFIG_GUNYAH_QCOM_PLATFORM=y
CONFIG_GUNYAH_IRQFD=y
CONFIG_GUNYAH_IOEVENTFD=y

# All distributions use the same hardware kernel.
CONFIG_LOCALVERSION="-piano-sunuefi-cachy"
CONFIG_LOCALVERSION_AUTO=n

# Keep full preemption and idle tick suppression from the hardware baseline.
# BORE uses its upstream defaults; MGLRU complements the existing Zstd ZRAM.
CONFIG_SCHED_BORE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_HZ_250=n
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_PREEMPT_DYNAMIC=y
