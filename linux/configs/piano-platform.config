# Qualcomm SCMI uses the standard performance/clock protocols.
# NXP vendor protocols must not attach to Qualcomm protocol 0x80.
CONFIG_IMX_SCMI_LMM_DRV=n
CONFIG_IMX_SCMI_CPU_DRV=n
CONFIG_IMX_SCMI_MISC_DRV=n
CONFIG_IMX_SCMI_LMM_EXT=n
CONFIG_IMX_SCMI_CPU_EXT=n
CONFIG_IMX_SCMI_MISC_EXT=n
CONFIG_IMX_SCMI_BBM_EXT=n
